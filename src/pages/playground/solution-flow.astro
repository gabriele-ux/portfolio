---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SolutionFlow from "../../components/SolutionFlow.astro";
---

<BaseLayout title="Playground — SolutionFlow">
  <main class="pg-main">
    <header class="pg-header">
      <a href="/playground" class="pg-back">← Playground</a>
      <p class="type-label pg-eyebrow">SOLUTION FLOW</p>
      <h1 class="type-h1 pg-title">Interactive userflow — static mockup</h1>
      <p class="type-body pg-desc">
        Desktop: horizontal grid with orthogonal connectors.
        Mobile (&lt; 768px): vertical stack grouped by phase.
        Clickable nodes have a "+" badge; passive nodes use a dashed border.
      </p>
    </header>

    <section class="pg-stage">
      <SolutionFlow />
    </section>

    <section class="pg-legend">
      <h2 class="type-h4">Legend</h2>
      <ul>
        <li>
          <span class="chip chip-clickable">Clickable</span>
          Opens a modal with image/video + description (interaction to be
          added in a follow-up).
        </li>
        <li>
          <span class="chip chip-passive">Passive</span>
          Narrative step, no interaction.
        </li>
        <li>
          <span class="chip chip-decision">Decision</span>
          Diamond marker for the branching point.
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .pg-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 64px 24px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .pg-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pg-back {
    display: inline-block;
    margin-bottom: 8px;
    color: var(--color-text-muted);
    font-size: var(--text-body-sm);
    text-decoration: none;
  }
  .pg-back:hover {
    color: var(--color-text-body);
  }
  .pg-eyebrow {
    color: var(--color-text-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .pg-title {
    color: var(--color-text-heading);
    margin: 0;
  }
  .pg-desc {
    color: var(--color-text-body-secondary);
    max-width: 60ch;
    margin: 0;
  }

  .pg-stage {
    padding: 24px;
    border: 1px solid var(--color-border-faint);
    border-radius: 12px;
    background: var(--color-bg-page);
  }

  .pg-legend {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pg-legend h2 {
    margin: 0;
    color: var(--color-text-heading);
  }
  .pg-legend ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--color-text-body);
    font-size: var(--text-body-sm);
  }
  .chip {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-right: 8px;
  }
  .chip-clickable {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-heading);
  }
  .chip-passive {
    background: transparent;
    border: 1px dashed var(--color-border-default);
    color: var(--color-text-body-secondary);
  }
  .chip-decision {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-emphasized);
    color: var(--color-text-heading);
  }
</style>
