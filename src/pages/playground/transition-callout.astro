---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TransitionCallout from "../../components/TransitionCallout.astro";

const variants = [
  { key: "warning", label: "Warning" },
  { key: "info", label: "Info" },
  { key: "neutral", label: "Neutral" },
] as const;
---

<BaseLayout title="Playground / TransitionCallout">
  <main class="mx-auto max-w-[900px] px-6 py-16 flex flex-col gap-12">
    <header class="flex flex-col gap-2">
      <a
        href="/playground"
        class="type-label inline-flex items-center gap-1 w-fit"
        style="color: var(--color-text-muted);"
      >
        ← BACK
      </a>
      <p class="type-label" style="color: var(--color-text-eyebrow);">
        COMPONENT
      </p>
      <h1 class="type-display" style="color: var(--color-text-heading);">
        TransitionCallout
      </h1>
      <p class="type-body" style="color: var(--color-text-body-secondary);">
        Highlighted box used to connect sections. Border variant controls the accent color.
      </p>
    </header>

    <section class="flex flex-col gap-4">
      <h2 class="type-label" style="color: var(--color-text-eyebrow);">
        VARIANTS
      </h2>
      <div class="flex flex-col gap-8">
        {
          variants.map((v) => (
            <div class="flex flex-col gap-2">
              <span class="type-label" style="color: var(--color-text-muted);">
                {v.label}
              </span>
              <TransitionCallout
                title="This impacted our work in two ways"
                variant={v.key}
              />
            </div>
          ))
        }
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="type-label" style="color: var(--color-text-eyebrow);">
        LONG TITLE
      </h2>
      <TransitionCallout
        title="I defined project objectives to guide the design phase"
        variant="info"
      />
    </section>
  </main>
</BaseLayout>
