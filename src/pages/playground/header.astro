---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
---

<BaseLayout title="Playground / Header">
  <section
    class="w-full border-b"
    style="border-color: var(--color-border-faint);"
  >
    <Header />
  </section>

  <main class="mx-auto max-w-[900px] px-6 py-16 flex flex-col gap-12">
    <header class="flex flex-col gap-2">
      <a
        href="/playground"
        class="type-label inline-flex items-center gap-1 w-fit"
        style="color: var(--color-text-muted);"
      >
        ← BACK
      </a>
      <p class="type-label" style="color: var(--color-text-eyebrow);">
        COMPONENT
      </p>
      <h1 class="type-display" style="color: var(--color-text-heading);">
        Header (Top bar)
      </h1>
      <p class="type-body" style="color: var(--color-text-body-secondary);">
        Sticky top bar (Figma 160:2109). Left: gradient icon + brand name in DM
        Sans 16. Right: orange Button (from Button.astro) with 44px height,
        radius 99. Padding 24 · 10. Turns glassy on scroll (blur + saturate).
      </p>
    </header>

    <section class="flex flex-col gap-4">
      <h2 class="type-label" style="color: var(--color-text-eyebrow);">
        DEFAULT
      </h2>
      <div
        class="border"
        style="border-color: var(--color-border-faint); background: var(--color-bg-page);"
      >
        <Header />
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="type-label" style="color: var(--color-text-eyebrow);">
        CUSTOM BRAND + CTA
      </h2>
      <div
        class="border"
        style="border-color: var(--color-border-faint); background: var(--color-bg-page);"
      >
        <Header
          brand="Studio LR"
          ctaLabel="Contact"
          ctaHref="mailto:hello@example.com"
        />
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="type-label" style="color: var(--color-text-eyebrow);">
        ON DARK CONTEXT
      </h2>
      <div
        class="border overflow-hidden"
        style="border-color: var(--color-border-faint); background: var(--color-neutral-800); border-radius: 12px;"
      >
        <Header />
      </div>
    </section>
  </main>
</BaseLayout>
