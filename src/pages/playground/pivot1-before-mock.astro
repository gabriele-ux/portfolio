---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Pivot1BeforeMock from "../../components/Pivot1BeforeMock.astro";
---

<BaseLayout title="Playground — Pivot1BeforeMock">
  <main class="pg-main">
    <header class="pg-header">
      <a href="/playground" class="pg-back">← Playground</a>
      <p class="type-label pg-eyebrow">PIVOT 1 · BEFORE MOCK</p>
      <h1 class="type-h1 pg-title">Change detector prototype</h1>
      <p class="type-body pg-desc">
        Rudimentary mock of the failed automatic detection script — shown
        as the "before" state in pivot 01. Rendered at its native 16:9
        aspect ratio inside the same panel it lives in on the case study.
      </p>
    </header>

    <section class="pg-stage">
      <Pivot1BeforeMock />
    </section>
  </main>
</BaseLayout>

<style>
  .pg-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 64px 24px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .pg-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pg-back {
    display: inline-block;
    margin-bottom: 8px;
    color: var(--color-text-muted);
    font-size: var(--text-body-sm);
    text-decoration: none;
  }
  .pg-back:hover {
    color: var(--color-text-body);
  }
  .pg-eyebrow {
    color: var(--color-text-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .pg-title {
    color: var(--color-text-heading);
    margin: 0;
  }
  .pg-desc {
    color: var(--color-text-body-secondary);
    max-width: 60ch;
    margin: 0;
  }
  .pg-stage {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-border-faint);
    border-radius: 12px;
    overflow: hidden;
    background: #f3f5f6;
  }
</style>
