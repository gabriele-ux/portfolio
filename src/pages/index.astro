---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TagList from "../components/TagList.astro";

const heroTags = [
  { label: "5yrs experience" },
  { label: "B2C" },
  { label: "Public sector" },
];

const projects = [
  {
    href: "/case-studies/design-system-search",
    title:
      "I built a system to keep 8+ designers aligned on<br />changes from 4+ libraries and reduce workload",
    heroImage: "/case-studies/design-system-search/cover-cs1.jpg",
    heroImageAlt: "Design System Search — case study cover",
    secondaryVideo: "/case-studies/design-system-search/cs1zoom.mp4",
    secondaryImage: "/case-studies/design-system-search/reminders.png",
    secondaryImageAlt: "Automatic reminders shown in a Slack-style card",
    tags: [
      { label: "Shipped", dot: "success" as const },
      { label: "AI" },
      { label: "Design System" },
      { label: "UX" },
    ],
  },
];
---

<BaseLayout title="Gabriele La Rosa — UX/Product Designer">
  <Header />

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner">
      <div class="hero-content">
        <div class="hero-tags">
          <TagList size="sm" tags={heroTags} />
        </div>
        <h1 id="hero-title" class="hero-claim">
          I&rsquo;m a <strong>Product designer</strong> that turns complexity into clarity, with expertise in <em>UX,&nbsp;</em>multi brand <em>design systems</em> and <em>governance.</em>
        </h1>
        <p class="hero-note">
          Currently exploring how to improve design workflows with AI.
        </p>
        <a class="hero-cta" href="#projects-heading">
          <span>Go to projects</span>
        </a>
      </div>

      <div class="hero-visual">
        <div class="hero-portrait-frame" data-tilt>
          <img
            class="hero-portrait"
            src="/hero/portrait.png"
            alt="Portrait of Gabriele La Rosa"
            width="434"
            height="443"
          />
        </div>
        <div class="hero-badge" aria-hidden="true">
          <svg
            class="hero-badge-text"
            viewBox="0 0 100 100"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <path
                id="hero-badge-path"
                d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
                fill="none"
              />
            </defs>
            <text>
              <textPath href="#hero-badge-path" startOffset="0">
                LET&rsquo;S DESIGN • LET&rsquo;S DESIGN •
              </textPath>
            </text>
          </svg>
          <img
            class="hero-badge-icon"
            src="/hero/badge-icon.svg"
            alt=""
            width="24"
            height="24"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="projects" aria-labelledby="projects-heading">
    <div class="projects-inner">
      <h2 id="projects-heading" class="projects-heading">
        <span>Selected projects</span>
        <img src="/hero/arrow-down.svg" alt="" width="14" height="14" />
      </h2>
      <div class="projects-grid">
        {
          projects.map((p) => (
            <ProjectCard
              href={p.href}
              title={p.title}
              heroImage={p.heroImage}
              heroImageAlt={p.heroImageAlt}
              secondaryVideo={p.secondaryVideo}
              secondaryImage={p.secondaryImage}
              secondaryImageAlt={p.secondaryImageAlt}
              tags={p.tags}
            />
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: clamp(3rem, 8vw, 6.5rem) clamp(1.25rem, 8vw, 10rem);
    background: var(--color-bg-page);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 64px;
    width: 100%;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .hero-claim {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-normal);
    font-size: clamp(1.375rem, calc(1.05rem + 1vw), 1.75rem);
    line-height: 1.35;
    color: var(--color-text-heading);
    margin: var(--spacing-16) 0 0;
    text-wrap: pretty;
    font-variation-settings: "opsz" 14;
  }

  .hero-claim strong {
    font-weight: var(--font-weight-bold);
    font-style: normal;
  }

  .hero-claim em {
    font-style: italic;
    font-weight: var(--font-weight-bold);
  }

  .hero-note {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-light);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--color-text-heading);
    margin: var(--spacing-16) 0 0;
    font-variation-settings: "opsz" 14;
  }

  .hero-tags {
    margin-top: 0;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-12);
    margin-top: var(--spacing-32);
    height: 44px;
    padding: 0 var(--spacing-20);
    border: 1px solid var(--color-neutral-800);
    border-radius: 999px;
    background-color: transparent;
    color: var(--color-neutral-800);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-medium);
    font-size: 0.875rem;
    line-height: 1;
    text-decoration: none;
    align-self: flex-start;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .hero-cta:hover {
    background-color: var(--color-neutral-800);
    color: var(--color-text-on-inverse);
  }

  .hero-cta img {
    display: block;
    width: 14px;
    height: 14px;
    transition: filter 180ms ease;
  }

  .hero-cta:hover img {
    filter: invert(1);
  }

  /* ── Visual: portrait + rotating badge ─────────────────────── */
  .hero-visual {
    position: relative;
    width: clamp(260px, 32vw, 440px);
    aspect-ratio: 217 / 221;
    flex-shrink: 0;
    perspective: 1200px;
    transform: scale(0.75);
    transform-origin: center;
  }

  .hero-portrait-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--color-neutral-0);
    transform-style: preserve-3d;
    transform-origin: center;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .hero-portrait-frame.is-tilting {
    transition: transform 120ms linear;
  }

  @media (hover: none) {
    .hero-portrait-frame {
      transform: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-portrait-frame,
    .hero-portrait-frame.is-tilting {
      transition: none;
      transform: none !important;
    }
  }

  .hero-portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-badge {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 45%;
    aspect-ratio: 1;
    transform: translate(-30%, 20%);
    border-radius: 50%;
    background: var(--color-orange-500);
    display: grid;
    place-items: center;
  }

  .hero-badge-text {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: hero-badge-spin 14s linear infinite;
  }

  .hero-badge-text text {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--font-weight-normal);
    letter-spacing: 0.14em;
    fill: var(--color-neutral-0);
    text-transform: uppercase;
  }

  .hero-badge-icon {
    display: block;
    width: 25%;
    height: 25%;
  }

  @keyframes hero-badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge-text {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      display: none;
    }
  }

  .projects {
    padding: var(--spacing-gap-section-lg) clamp(1.25rem, 8vw, 10rem);
  }

  .projects-inner {
    max-width: 1600px;
    margin: 0 auto;
  }

  .projects-heading {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-8);
    font-family: var(--font-mono);
    font-weight: var(--font-weight-normal);
    font-size: var(--text-h5);
    line-height: var(--text-h5--line-height);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-heading);
    margin: 0 0 var(--spacing-gap-section-lg);
  }

  .projects-heading img {
    display: block;
    width: 14px;
    height: 14px;
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-section);
  }
</style>
