---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import HeroCover from "../../components/HeroCover.astro";
import TagList from "../../components/TagList.astro";
import MetaBox from "../../components/MetaBox.astro";
import MetaItem from "../../components/MetaItem.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import QuestionsDiagram from "../../components/QuestionsDiagram.astro";
import SolutionFlow from "../../components/SolutionFlow.astro";
import Accordion from "../../components/Accordion.astro";
import Media from "../../components/Media.astro";
import CalloutList from "../../components/CalloutList.astro";
import CalloutItem from "../../components/CalloutItem.astro";
import PrioritizationMatrix from "../../components/PrioritizationMatrix.astro";
import ImpactCard from "../../components/ImpactCard.astro";
import Spacer from "../../components/Spacer.astro";
import CaseStudyNav from "../../components/CaseStudyNav.astro";
import CaseStudyFooter from "../../components/CaseStudyFooter.astro";
import FeatureShowcase from "../../components/FeatureShowcase.astro";

const solutionPreviewFeatures = [
  {
    id: "guided-flow",
    name: "Guided flow",
    caption:
      "A step-by-step form asks only for the context designers can provide. Name, date, and author fill in automatically.",
    src: "/case-studies/design-system-search/form.mp4",
  },
  {
    id: "sync-queue",
    name: "Sync queue",
    caption:
      "Pending changes stay visible before publishing, so designers can review, edit, or remove entries before they go out.",
    src: "/case-studies/design-system-search/sync.mp4",
  },
  {
    id: "structured-history",
    name: "Structured history",
    caption:
      "Each component gets its own Markdown file in a shared repository — readable, versioned, and reusable.",
    src: "/case-studies/design-system-search/pivot3.mp4",
  },
];

const matrixItems = [
  {
    id: "figma-tracking",
    title: "Track on Figma",
    x: 90,
    y: 14,
    needs: { frictionless: true, retrievable: false, proactive: false },
    rows: [
      { type: "check" as const, text: "Already in the workflow" },
      {
        type: "cross" as const,
        text: "Require to search manually each page to find information",
        emphasis: "fails: proactive + retrievability",
      },
    ],
  },
  {
    id: "figma-release-notes",
    title: "Figma Release Notes",
    x: 66,
    y: 30,
    needs: { frictionless: true, retrievable: false, proactive: false },
    rows: [
      { type: "check" as const, text: "Native in the tool" },
      {
        type: "cross" as const,
        text: "Not tied to individual components, and not searchable",
        emphasis: "fails: proactive + retrievability",
      },
    ],
  },
  {
    id: "community-plugins",
    title: "Community Plugins",
    x: 84,
    y: 42,
    needs: { frictionless: true, retrievable: false, proactive: false },
    rows: [
      { type: "check" as const, text: "Already integrated in Figma" },
      {
        type: "cross" as const,
        text: "None allowed to easily retrieve information",
        emphasis: "fails: proactive + retrievability",
      },
    ],
  },
  {
    id: "zeroheight",
    title: "Zeroheight",
    x: 20,
    y: 78,
    needs: { frictionless: false, retrievable: true, proactive: true },
    rows: [
      {
        type: "check" as const,
        text: "Changelog and release notes out of the box",
      },
      {
        type: "cross" as const,
        text: "Another touchpoint to maintain",
        emphasis: "fails: frictionless",
      },
    ],
  },
  {
    id: "custom-plugin",
    title: "Custom Plugin",
    x: 82,
    y: 82,
    isSolution: true,
    needs: { frictionless: true, retrievable: true, proactive: true },
    rows: [
      {
        type: "check" as const,
        text: "Lives inside Figma, no context switch",
      },
      {
        type: "check" as const,
        text: "Full control over how data is stored and queried",
      },
      {
        type: "check" as const,
        text: "Communication can be automated",
      },
    ],
  },
];

const navSections = [
  { id: "problem", label: "Problem" },
  { id: "discovery", label: "Discovery" },
  { id: "decisions", label: "Decisions" },
  { id: "solution", label: "Solution" },
  { id: "impact", label: "Impact" },
  { id: "learnings", label: "Learnings" },
];

const title =
  "I built a workflow to keep component changes traceable across teams";

const heroTags = [
  { label: "Shipped", dot: "success" as const },
  { label: "Design System" },
  { label: "Internal tool" },
];

const heroMeta = [
  { label: "ROLE", value: "Full end-to-end ownership" },
  { label: "TIMELINE", value: "6 weeks" },
  {
    label: "TECHNIQUES",
    value: "Data analysis, benchmark, flow mapping, prototyping, user testing",
  },
  { label: "TOOLS", value: "Figma, Claude Code, GitHub, Slack" },
];

const cover = "/case-studies/design-system-search/bgcs1.jpg";
const screen = "/case-studies/design-system-search/screencs1.png";
---

<CaseStudyLayout title={title}>
  <HeroCover
    src={cover}
    alt="Case study background"
    screen={screen}
    screenAlt="Case study screen preview"
  />

  <div class="case-study-body">
    <CaseStudyNav sections={navSections} />

    <article class="case-study">
      <Spacer size="md" />

      <!-- HERO CONTENT -->
      <section class="hero-content">
        <h1 class="type-display" style="color: var(--color-text-heading);">
          {title}
        </h1>
        <TagList tags={heroTags} />
      </section>

      <Spacer size="sm" />

      <MetaBox>
        {heroMeta.map((m) => <MetaItem label={m.label} value={m.value} />)}
      </MetaBox>

      <Spacer size="lg" />

      <!-- OVERVIEW -->
      <section class="section">
        <SectionHeader
          eyebrow="Overview"
          title="A growing Design System with governance still taking shape"
        />
        <p class="body-copy">
          I'm part of a <strong>3-person Design System team</strong> maintaining shared
          libraries across multiple products and brands. Product
          designers also evolve components inside their own UI Kits.
        </p>
        <p class="body-copy">
          Governance was still being defined, so ownership, change
          tracking and communication were <strong>not always consistent</strong>. I owned
          this <strong>6-week internal project end to end</strong>, from understanding the
          problem and testing workflows to designing and building the
          final solution.
        </p>
      </section>

      <Spacer size="lg" />

      <!-- PROBLEM -->
      <section class="section">
        <SectionHeader
          id="problem"
          eyebrow="Problem"
          title="Information about component changes was getting lost"
        />
        <QuestionsDiagram />
        <p class="body-copy">
          Component changes happened across Design System libraries and
          product UI Kits, but the related information was <strong>spread across
          Slack, Figma files, emails and conversations</strong>. When designers
          needed to understand what had changed, why, or which version to
          use, they often had to <strong>search across different sources or ask
          the Design System team</strong>.
        </p>
        <MetaBox variant="data">
          <MetaItem label="TICKET ANALYSIS — 1 YEAR PERIOD">
            <strong>12%</strong> of <strong>273</strong> requests were
            related to <strong>component changes</strong> or which version
            to use
          </MetaItem>
        </MetaBox>
      </section>

      <Spacer size="md" />

      <!-- PAIN POINTS -->
      <section class="section-tight">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          This created two problems
        </h3>
        <CalloutList>
          <CalloutItem
            title="Time spent reconstructing decisions"
            variant="warning"
            badge="TEAM DESIGN SYSTEM"
            badgeColor="var(--color-accent-info)"
          >
            Past changes had to be pieced together from messages, files
            and people whenever the original context was missing.
          </CalloutItem>
          <CalloutItem
            title="Limited visibility across projects"
            variant="warning"
            badge="TEAM UX/UI"
          >
            Designers could miss changes happening elsewhere, increasing
            the risk of using an outdated component or duplicating work
            already done in another project.
          </CalloutItem>
        </CalloutList>
      </section>

      <Spacer size="lg" />

      <!-- THE SOLUTION — preview with final feature videos + headline results -->
      <section class="section" id="solution-preview">
        <SectionHeader
          eyebrow="Solution preview"
          title="The solution"
        />
        <FeatureShowcase features={solutionPreviewFeatures} />
        <div class="impact-row">
          <ImpactCard
            title="Shared source of truth"
            metricValue={1}
            metricSuffix="source"
            arrow={false}
            beforeLabel="BEFORE"
            beforeValue="Split across Slack, email, files and people"
          />
          <ImpactCard
            title="Recover change context"
            metricPrefix="~"
            metricValue={5}
            metricSuffix="min"
            color="info"
            beforeLabel="BEFORE"
            beforeValue="Up to 1 working day"
          />
          <ImpactCard
            title="Active adoption"
            metricValue={6}
            metricSuffix="/ 8 designers"
            arrow={false}
            beforeLabel="BEFORE"
            beforeValue="Logged at least one change in the last 30 days"
          />
        </div>
      </section>

      <Spacer size="lg" />

      <!-- DISCOVERY -->
      <section class="section">
        <SectionHeader
          id="discovery"
          eyebrow="Discovery"
          title="I looked at the workflow before choosing a solution"
        />
      </section>

      <Spacer size="md" />

      <!-- DISCOVERY — Mapping where information was getting lost -->
      <div class="sub-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          Mapping where information was getting lost
        </h3>
        <p class="body-copy">
          I mapped how component changes were communicated between the
          Design System and product teams. A process already existed, but
          it relied on people <strong>manually sharing updates</strong> through Slack,
          email or direct conversations. In practice, it was <strong>not followed
          consistently</strong>.
        </p>
        <Media
          src="/case-studies/design-system-search/discovery.jpg"
          alt="Actual workflow between UX/UI and Design System teams and the major pain point"
          caption="THE ACTUAL WORKFLOW AND THE MAJOR PAINT POINT"
        />
      </div>

      <Spacer size="md" />

      <!-- DISCOVERY — Looking at how other teams handled it -->
      <div class="sub-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          Looking at how other teams handled it
        </h3>
        <p class="body-copy">
          I benchmarked <strong>10 Design Systems</strong> to understand how they
          tracked component changes. Changelogs, release notes and
          documentation tools were the most common patterns, so I
          shortlisted the options that could realistically work in our
          context.
        </p>
        <div class="todo-placeholder">
          <span class="todo-label">TODO — Asset</span>
          <div class="todo-body">
            <strong>Benchmark visual</strong>
            <p>
              Reuse the current benchmark visual, kept as a secondary
              reference supporting the decision.
            </p>
          </div>
        </div>
      </div>

      <Spacer size="md" />

      <!-- DISCOVERY — Comparing the options with designers -->
      <div class="sub-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          Comparing the options with designers
        </h3>
        <p class="body-copy">
          I reviewed the most relevant approaches with the designers who
          would have to maintain them.
        </p>
        <p class="body-copy">
          Testing surfaced a practical constraint: <strong>adding another manual workflow would make adoption difficult.</strong>
        </p>
        <p class="body-copy">
          Tools outside Figma offered better documentation, but
          introduced <strong>another place to maintain</strong>. Lighter Figma-based
          approaches reduced that friction, but offered <strong>less control over
          how the information could be stored and reused</strong>. From those
          observations, three requirements emerged to guide the decision:
        </p>
        <CalloutList>
          <CalloutItem
            title="Frictionless"
            variant="info"
            iconStyle="filled"
          >
            <svg
              slot="icon"
              width="20"
              height="20"
              viewBox="0 0 21 21"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M16.9493 9.94365L8.07237 19.4546C7.9783 19.555 7.85413 19.622 7.7186 19.6457C7.58307 19.6693 7.44353 19.6482 7.32103 19.5856C7.19854 19.5229 7.09974 19.4222 7.03954 19.2985C6.97935 19.1748 6.96103 19.0348 6.98734 18.8998L8.14926 13.0878L3.58163 11.3727C3.48353 11.336 3.39605 11.2755 3.32701 11.1968C3.25796 11.118 3.2095 11.0234 3.18595 10.9214C3.1624 10.8193 3.16449 10.713 3.19205 10.612C3.2196 10.5109 3.27176 10.4183 3.34385 10.3423L12.2207 0.831376C12.3148 0.730984 12.439 0.663913 12.5745 0.640283C12.71 0.616653 12.8496 0.637746 12.9721 0.70038C13.0946 0.763013 13.1934 0.863789 13.2536 0.987499C13.3138 1.11121 13.3321 1.25114 13.3058 1.38618L12.1407 7.2045L16.7083 8.91726C16.8057 8.9542 16.8925 9.01455 16.961 9.09299C17.0295 9.17143 17.0776 9.26554 17.1011 9.367C17.1246 9.46846 17.1228 9.57414 17.0957 9.67471C17.0687 9.77529 17.0173 9.86765 16.9461 9.94365H16.9493Z"
                fill="currentColor"
              ></path>
            </svg>
            It had to fit the existing workflow or adoption would be
            difficult.
          </CalloutItem>
          <CalloutItem
            title="Retrievable"
            variant="info"
            iconStyle="outlined"
          >
            <svg
              slot="icon"
              width="20"
              height="20"
              viewBox="0 0 21 21"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M10.145 1.26807C8.29586 1.27016 6.52304 2.00567 5.21549 3.31322C3.90794 4.62078 3.17243 6.3936 3.17033 8.24275C3.17033 14.2109 9.51096 18.7183 9.78123 18.9069C9.88784 18.9816 10.0149 19.0216 10.145 19.0216C10.2752 19.0216 10.4022 18.9816 10.5088 18.9069C10.7791 18.7183 17.1197 14.2109 17.1197 8.24275C17.1176 6.3936 16.3821 4.62078 15.0746 3.31322C13.767 2.00567 11.9942 1.27016 10.145 1.26807ZM10.145 5.7065C10.6466 5.7065 11.137 5.85525 11.5541 6.13394C11.9712 6.41263 12.2962 6.80873 12.4882 7.27217C12.6802 7.73561 12.7304 8.24557 12.6325 8.73755C12.5347 9.22954 12.2931 9.68145 11.9384 10.0362C11.5837 10.3909 11.1318 10.6324 10.6398 10.7303C10.1478 10.8281 9.63788 10.7779 9.17444 10.5859C8.711 10.394 8.31489 10.0689 8.03621 9.65182C7.75752 9.23474 7.60877 8.74438 7.60877 8.24275C7.60877 7.5701 7.87598 6.92499 8.35162 6.44935C8.82726 5.97372 9.47237 5.7065 10.145 5.7065Z"
                fill="currentColor"
              ></path>
            </svg>
            Past changes needed a stable place where they could be found
            later.
          </CalloutItem>
          <CalloutItem
            title="Proactive"
            variant="info"
            iconStyle="filled"
          >
            <svg
              slot="icon"
              width="20"
              height="20"
              viewBox="0 0 21 21"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18.1404 2.07577C18.0422 1.99094 17.9227 1.93452 17.7947 1.9126C17.6668 1.89067 17.5353 1.90406 17.4144 1.95134L1.35205 8.23728C1.12441 8.32579 0.93169 8.48587 0.802896 8.6934C0.674103 8.90092 0.616211 9.14468 0.637937 9.38795C0.659663 9.63123 0.759831 9.86087 0.92336 10.0423C1.08689 10.2237 1.30493 10.3471 1.54465 10.3939L5.70648 11.211V15.8516C5.70566 16.1043 5.78078 16.3515 5.92209 16.5611C6.06341 16.7707 6.26441 16.933 6.49906 17.027C6.73334 17.1226 6.99098 17.1456 7.23849 17.0929C7.48599 17.0402 7.71191 16.9142 7.88686 16.7313L9.89367 14.65L13.0775 17.4367C13.3072 17.6405 13.6034 17.7532 13.9105 17.7538C14.045 17.7537 14.1787 17.7325 14.3067 17.6911C14.5159 17.6248 14.7041 17.5047 14.8525 17.343C15.0009 17.1813 15.1043 16.9835 15.1524 16.7694L18.3695 2.77403C18.3983 2.64782 18.3922 2.51615 18.3518 2.39314C18.3115 2.27013 18.2384 2.16042 18.1404 2.07577ZM13.912 16.4856L7.359 10.7394L16.7907 3.97955L13.912 16.4856Z"
                fill="currentColor"
              ></path>
            </svg>
            Important changes needed to reach people, not just wait to be
            searched for.
          </CalloutItem>
        </CalloutList>
        <PrioritizationMatrix items={matrixItems} />
      </div>

      <Spacer size="lg" />

      <!-- KEY DECISIONS -->
      <section class="section">
        <SectionHeader
          id="decisions"
          eyebrow="Key decisions"
          title="Three UX decisions shaped the workflow"
        />
      </section>

      <Spacer size="md" />

      <!-- KEY DECISION 01 — Guided flow -->
      <div class="pivot-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          01. I replaced free-form input with a guided flow
        </h3>
        <p class="body-copy">
          The first versions <strong>relied too much on designers remembering
          what to document</strong>. I tested three approaches: a manual table,
          automatic change detection and a guided form.
        </p>
        <Accordion
          items={[
            { label: "Manual table", value: "option3" },
            { label: "Automatic detection", value: "before" },
            { label: "Guided form (chosen)", value: "after", chosen: true },
          ]}
        >
          <div slot="after" class="acc-content-group">
            <div class="pivot-panel">
              <video
                src="/case-studies/design-system-search/form.mp4"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              ></video>
            </div>
            <p class="body-copy">
              The plugin asks designers <strong>only for information that
              requires their context</strong>. Component name, date and author
              can be filled automatically, while the reason for the
              change stays as user input.
            </p>
          </div>
          <div slot="before" class="acc-content-group">
            <div class="pivot-panel pivot-panel-centered">
              <img
                src="/case-studies/design-system-search/manually.png"
                alt="Change detector prototype: automatic detection listing every node change with a per-row request to add context"
              />
            </div>
            <p class="body-copy">
              On complex files it <strong>missed meaningful changes, flagged
              irrelevant edits</strong> and still could not capture why a change
              had been made.
            </p>
          </div>
          <div slot="option3" class="acc-content-group">
            <div class="pivot-panel pivot-panel-centered">
              <img
                src="/case-studies/design-system-search/manual.png"
                alt="Manual table under each component that designers fill in by hand"
              />
            </div>
            <p class="body-copy">
              Designers entered only the minimum information and <strong>often
              missed useful context</strong>.
            </p>
          </div>
        </Accordion>
        <p class="body-copy">
          <strong>Decision:</strong> use a guided flow that reduces
          effort without removing the context only designers can
          provide.
        </p>
      </div>

      <Spacer size="md" />

      <!-- KEY DECISION 02 — Sync queue -->
      <div class="pivot-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          02. I added a sync queue to make status visible
        </h3>
        <p class="body-copy">
          During testing, designers were <strong>not always sure which changes
          had already been synced</strong> and which ones were still pending. That
          uncertainty made it harder to understand whether an entry still
          needed action and increased the risk of <strong>duplicate or missed
          updates</strong>.
        </p>
        <div class="todo-placeholder">
          <span class="todo-label">TODO — Observation</span>
          <div class="todo-body">
            <strong>What I observed</strong>
            <p>
              Add the clearest behaviour seen during testing. Keep it to
              1–2 sentences.
            </p>
          </div>
        </div>
        <div class="todo-placeholder">
          <span class="todo-label">TODO — Asset</span>
          <div class="todo-body">
            <strong>Sync queue visual</strong>
            <p>
              Screenshot or short video of the Sync Queue showing pending
              entries and the ability to review, edit or remove them
              before syncing.
            </p>
          </div>
        </div>
        <p class="body-copy">
          <strong>Decision:</strong> make pending work visible before
          sync, so designers can understand the system status and review
          changes before publishing.
        </p>
      </div>

      <Spacer size="md" />

      <!-- KEY DECISION 03 — Simplified setup -->
      <div class="pivot-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          03. I simplified setup so designers could start without
          technical support
        </h3>
        <p class="body-copy">
          The plugin needed to connect to the repository before it could
          be used, but the first setup required configuration steps that
          were <strong>not clear to non-technical users</strong>. This created an
          <strong>unnecessary dependency on the Design System team during
          onboarding</strong>.
        </p>
        <div class="todo-placeholder">
          <span class="todo-label">TODO — Observation</span>
          <div class="todo-body">
            <strong>What I observed</strong>
            <p>
              Add the main issue seen during rollout or testing. Avoid
              listing every setup problem.
            </p>
          </div>
        </div>
        <div class="todo-placeholder">
          <span class="todo-label">TODO — Asset</span>
          <div class="todo-body">
            <strong>Simplified onboarding visual</strong>
            <p>
              Before / after of the setup flow or a short video of the
              simplified onboarding.
            </p>
          </div>
        </div>
        <p class="body-copy">
          <strong>Decision:</strong> reduce the setup to the minimum
          information designers need and automate configuration wherever
          possible.
        </p>
      </div>

      <Spacer size="lg" />

      <!-- TECHNICAL TRADE-OFF -->
      <section class="section">
        <SectionHeader
          eyebrow="Technical trade-off"
          title="I chose an architecture I could realistically ship"
        />
        <p class="body-copy">
          I explored three ways to store and retrieve the changelog
          data.
        </p>
        <Accordion
          items={[
            { label: "Single Markdown file", value: "before" },
            { label: "RAG database", value: "option3" },
            {
              label: "Structured GitHub repository (chosen)",
              value: "after",
              chosen: true,
            },
          ]}
        >
          <div slot="after" class="acc-content-group">
            <div class="pivot-panel">
              <video
                src="/case-studies/design-system-search/pivot3.mp4"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              ></video>
            </div>
            <p class="body-copy">
              One Markdown file per component. It was <strong>readable, reusable
              and realistic to maintain</strong> within the six-week project.
            </p>
          </div>
          <div slot="before" class="acc-content-group">
            <p class="body-copy">
              Simple to implement, but <strong>concurrent edits created overwrite
              issues</strong> and retrieval became inefficient.
            </p>
          </div>
          <div slot="option3" class="acc-content-group">
            <p class="body-copy">
              Better suited to semantic retrieval at scale, but the <strong>setup
              and maintenance cost was too high</strong> for the first release.
            </p>
          </div>
        </Accordion>
        <p class="body-copy">
          <strong>Decision:</strong> use the simplest structure that
          solved the current reliability problem and keep the option to
          add a retrieval layer later.
        </p>
        <p class="body-copy caveat">
          This trade-off becomes important again in the limitation
          section.
        </p>
      </section>

      <Spacer size="lg" />

      <!-- SHIPPED SOLUTION -->
      <section class="section">
        <SectionHeader
