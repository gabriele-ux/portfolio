---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import HeroCover from "../../components/HeroCover.astro";
import TagList from "../../components/TagList.astro";
import MetaBox from "../../components/MetaBox.astro";
import MetaItem from "../../components/MetaItem.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Media from "../../components/Media.astro";
import TransitionCallout from "../../components/TransitionCallout.astro";
import CalloutList from "../../components/CalloutList.astro";
import CalloutItem from "../../components/CalloutItem.astro";
import OptionCardList from "../../components/OptionCardList.astro";
import OptionCard from "../../components/OptionCard.astro";
import OptionRow from "../../components/OptionRow.astro";
import EvaluationTable from "../../components/EvaluationTable.astro";
import SolutionFlow from "../../components/SolutionFlow.astro";
import StrategyFlow from "../../components/StrategyFlow.astro";
import Pivot2BeforeSchema from "../../components/Pivot2BeforeSchema.astro";
import Pivot1BeforeMock from "../../components/Pivot1BeforeMock.astro";

const evaluationOptions = [
  {
    title: "1. Track on Figma",
    rows: [
      { type: "check" as const, text: "Already in the workflow" },
      {
        type: "cross" as const,
        text: "Require to search manually each page to find information",
        emphasis: "fails: proactive + retrievability",
      },
    ],
  },
  {
    title: "2. Figma Release Note",
    rows: [
      { type: "check" as const, text: "Native in the tool" },
      {
        type: "cross" as const,
        text: "Not tied to individual components, and not searchable",
        emphasis: "fails: proactive + retrievability",
      },
    ],
  },
  {
    title: "3. Community Plugins",
    rows: [
      { type: "check" as const, text: "Already integrated in Figma" },
      {
        type: "cross" as const,
        text: "None allowed to easily retrieve information",
        emphasis: "fails: proactive + frictionless",
      },
    ],
  },
  {
    title: "4. ZeroHeight",
    rows: [
      {
        type: "check" as const,
        text: "Changelog and release notes out of the box",
      },
      {
        type: "cross" as const,
        text: "Another touchpoint to maintain",
        emphasis: "fails: frictionless",
      },
    ],
  },
];
import Confront from "../../components/Confront.astro";
import Spacer from "../../components/Spacer.astro";
import CaseStudyNav from "../../components/CaseStudyNav.astro";
import ImpactCardList from "../../components/ImpactCardList.astro";
import ImpactCard from "../../components/ImpactCard.astro";
import CaseStudyFooter from "../../components/CaseStudyFooter.astro";

const navSections = [
  { id: "in-short", label: "In Short" },
  { id: "background", label: "The Background" },
  { id: "problem", label: "The Problem" },
  { id: "discovery", label: "Discovery" },
  { id: "research", label: "Research & Constraints" },
  { id: "strategy", label: "Strategy" },
  { id: "pivots", label: "Pivots" },
  { id: "solution", label: "Solution" },
  { id: "impact", label: "Impact" },
  { id: "learnings", label: "Learnings" },
];

const title =
  "I built a system to keep 8+ designers aligned on changes from 4+ libraries";

const heroTags = [
  { label: "Shipped", dot: "success" as const },
  { label: "AI" },
  { label: "Design System" },
  { label: "UX" },
];

const heroMeta = [
  { label: "ROLE", value: "Full end-to-end ownership" },
  { label: "TIMELINE", value: "6 weeks" },
  {
    label: "TECHNIQUES",
    value:
      "Data Analysis, Benchmark, Interviews, Flow Mapping, Prototyping, User Tests",
  },
  { label: "TOOLS", value: "Claude Code, Figjam" },
];

const cover = "/case-studies/design-system-search/bgcs1.jpg";
const screen = "/case-studies/design-system-search/screencs1.png";
---

<CaseStudyLayout title={title}>
  <HeroCover
    src={cover}
    alt="Case study background"
    screen={screen}
    screenAlt="Case study screen preview"
  />

  <div class="case-study-body">
    <CaseStudyNav sections={navSections} />

    <article class="case-study">
    <Spacer size="md" />

    <section class="hero-content">
      <h1 class="type-display" style="color: var(--color-text-heading);">
        {title}
      </h1>
      <TagList tags={heroTags} />
    </section>

    <Spacer size="sm" />

    <MetaBox>
      {heroMeta.map((m) => <MetaItem label={m.label} value={m.value} />)}
    </MetaBox>

    <Spacer size="sm" />

    <!-- IN SHORT / TL;DR -->
    <aside id="in-short" class="in-short" aria-label="TL;DR summary">
      <p class="eyebrow-line in-short-eyebrow">IN SHORT</p>
      <dl class="in-short-list">
        <div class="in-short-row">
          <dt class="in-short-term">The problem</dt>
          <dd class="in-short-def">
            Design System changes lived in Slack, email and heads. Designers
            spent up to a full day reconstructing context and often missed
            updates.
          </dd>
        </div>
        <div class="in-short-row">
          <dt class="in-short-term">What I did</dt>
          <dd class="in-short-def">
            Defined a solution around the team's workflow and needs. Built a
            Figma plugin and a GitHub-based source of truth that capture
            changes to libraries and structure the data for AI to pick up,
            powering things like automatic release notes and advanced search
            so everyone stays up to date.
          </dd>
        </div>
        <div class="in-short-row">
          <dt class="in-short-term">Result</dt>
          <dd class="in-short-def">
            <strong>1 unified source of truth.</strong> Context recovery from <strong>~1 day</strong> to <strong>~5 min</strong>, weekly release note creation from <strong>~4h</strong> to <strong>~25 min</strong>, adopted by <strong>6/8</strong> designers.
          </dd>
        </div>
      </dl>
      <a href="#solution" class="in-short-cta">
        <span>See how the solution works</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 256 256"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"
          ></path>
        </svg>
      </a>
    </aside>

    <Spacer size="lg" />

    <!-- BACKGROUND -->
    <section class="section">
      <SectionHeader
        id="background"
        eyebrow="The background"
        title="One complex system growing at different speed"
      />
      <p class="body-copy">
        I'm part of a small <strong>Design System team at a big
        multinational</strong>. There are <strong>3 of us</strong>, and we
        maintain the main libraries across <strong>4 touchpoints and 5+
        brands</strong>, used by around <strong>8 designers</strong>.
      </p>
      <p class="body-copy">
        The Design System is still relatively new, and its governance is
        being built while products keep moving. <strong>5+ vertical
        products</strong> run in parallel, each with its own timelines and,
        when needed, its own UI Kit for product-specific needs.
      </p>
      <p class="body-copy">
        This means components can <strong>evolve in different places and at
        different speeds</strong>. Our job is to keep those changes aligned
        and make sure the Design System remains a reliable reference for
        everyone.
      </p>
      <Media
        src="/case-studies/design-system-search/diagram-teams.jpg"
        alt="Applications and product teams responsibilities diagram"
        caption="TEAMS' RESPONSABILITIES AND INTERACTION"
        aspect="3032 / 1440"
      />
    </section>

    <Spacer size="lg" />

    <!-- PROBLEM -->
    <section class="section">
      <SectionHeader
        id="problem"
        eyebrow="Problem"
        title="Design System changes were getting lost between teams"
      />
      <p class="body-copy">
        The same questions kept coming back:
      </p>
      <Media
        src="/case-studies/design-system-search/diagram-questions.jpg"
        alt="Recurring questions from designers"
      />
      <MetaBox variant="data">
        <MetaItem label="TICKET ANALYSIS - 1 YEAR PERIOD">
          <strong>12%</strong> of <strong>273</strong> requests where about <strong>component changes</strong> or which version to use
        </MetaItem>
      </MetaBox>
      <p class="body-copy">
        This wasn't just slowing down the Design System team. It also meant
        that UX/UI designers could <strong>miss changes</strong> while
        working on their projects, creating their own adaptations or using
        an outdated version.
      </p>
    </section>

    <Spacer size="xs" />

    <TransitionCallout
      title="This impacted our work in two ways"
      variant="warning"
    />

    <Spacer size="xs" />

    <!-- PAIN POINTS -->
    <section class="section-tight">
      <p class="eyebrow-line">THE PROBLEMS</p>
      <CalloutList>
        <CalloutItem
          title="Hours lost reconstructing context"
          variant="warning"
          badge="TEAM DESIGN SYSTEM"
          badgeColor="var(--color-accent-info)"
        >
          Finding out what changed, why, and when could take up to a full
          working day, searching through Slack, email and conversations.
        </CalloutItem>
        <CalloutItem
          title="No visibility on other projects"
          variant="warning"
          badge="TEAM UX/UI"
        >
          They couldn't see how components were changing in other projects.
          When they had to pick one, they didn't know if a newer version was
          in the works, or whether their edits would affect other teams.
        </CalloutItem>
      </CalloutList>
    </section>


    <Spacer size="sm" />

    <p class="body-copy">
      We already had a process to communicate changes but{" "}
      <strong>it wasn't working</strong>. I needed to find out why.
    </p>

    <Spacer size="lg" />

    <!-- DISCOVERY -->
    <section class="section">
      <SectionHeader
        id="discovery"
        eyebrow="Discovery"
        title="The problem wasn't communication. It was where the information lived."
      />
      <p class="body-copy">
        To understand why the same questions kept coming back, I{" "}
        <strong>audited the workflow</strong> between the Design System and UI
        teams and looked at the cases behind those requests.
      </p>
      <Media
        src="/case-studies/design-system-search/discovery.jpg"
        alt="Actual workflow between UX/UI and Design System teams"
        caption="THE ACTUAL WORKFLOW AND THE MAJOR PAINT POINT"
      />
      <p class="body-copy">
        The existing workflow did have a communication step: changes were
        shared through Slack or email, but <strong>only with the person who
        requested them</strong>, so <strong>visibility never reached the rest
        of the teams</strong>.
      </p>
    </section>

    <Spacer size="xs" />

    <MetaBox variant="insight">
      <MetaItem
        label="INSIGHT"
        value="Changes were communicated, but there was no shared source of truth for tracking and retrieving them."
      />
    </MetaBox>

    <Spacer size="xs" />

    <TransitionCallout
      title="I defined three requirements for the solution"
      variant="info"
    />

    <Spacer size="sm" />

    <!-- OUR NEEDS -->
    <section class="section-tight">
      <p class="eyebrow-line">OUR NEEDS</p>
      <CalloutList>
        <CalloutItem
          title="Frictionless"
          variant="info"
          iconStyle="filled"
        >
          <svg
            slot="icon"
            width="20"
            height="20"
            viewBox="0 0 21 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M16.9493 9.94365L8.07237 19.4546C7.9783 19.555 7.85413 19.622 7.7186 19.6457C7.58307 19.6693 7.44353 19.6482 7.32103 19.5856C7.19854 19.5229 7.09974 19.4222 7.03954 19.2985C6.97935 19.1748 6.96103 19.0348 6.98734 18.8998L8.14926 13.0878L3.58163 11.3727C3.48353 11.336 3.39605 11.2755 3.32701 11.1968C3.25796 11.118 3.2095 11.0234 3.18595 10.9214C3.1624 10.8193 3.16449 10.713 3.19205 10.612C3.2196 10.5109 3.27176 10.4183 3.34385 10.3423L12.2207 0.831376C12.3148 0.730984 12.439 0.663913 12.5745 0.640283C12.71 0.616653 12.8496 0.637746 12.9721 0.70038C13.0946 0.763013 13.1934 0.863789 13.2536 0.987499C13.3138 1.11121 13.3321 1.25114 13.3058 1.38618L12.1407 7.2045L16.7083 8.91726C16.8057 8.9542 16.8925 9.01455 16.961 9.09299C17.0295 9.17143 17.0776 9.26554 17.1011 9.367C17.1246 9.46846 17.1228 9.57414 17.0957 9.67471C17.0687 9.77529 17.0173 9.86765 16.9461 9.94365H16.9493Z"
              fill="currentColor"
            ></path>
          </svg>
          The solution needs to fit into our teams' workflow, or it won't
          be adopted.
        </CalloutItem>
        <CalloutItem
          title="Retrievabile"
          variant="info"
          iconStyle="outlined"
        >
          <svg
            slot="icon"
            width="20"
            height="20"
            viewBox="0 0 21 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M10.145 1.26807C8.29586 1.27016 6.52304 2.00567 5.21549 3.31322C3.90794 4.62078 3.17243 6.3936 3.17033 8.24275C3.17033 14.2109 9.51096 18.7183 9.78123 18.9069C9.88784 18.9816 10.0149 19.0216 10.145 19.0216C10.2752 19.0216 10.4022 18.9816 10.5088 18.9069C10.7791 18.7183 17.1197 14.2109 17.1197 8.24275C17.1176 6.3936 16.3821 4.62078 15.0746 3.31322C13.767 2.00567 11.9942 1.27016 10.145 1.26807ZM10.145 5.7065C10.6466 5.7065 11.137 5.85525 11.5541 6.13394C11.9712 6.41263 12.2962 6.80873 12.4882 7.27217C12.6802 7.73561 12.7304 8.24557 12.6325 8.73755C12.5347 9.22954 12.2931 9.68145 11.9384 10.0362C11.5837 10.3909 11.1318 10.6324 10.6398 10.7303C10.1478 10.8281 9.63788 10.7779 9.17444 10.5859C8.711 10.394 8.31489 10.0689 8.03621 9.65182C7.75752 9.23474 7.60877 8.74438 7.60877 8.24275C7.60877 7.5701 7.87598 6.92499 8.35162 6.44935C8.82726 5.97372 9.47237 5.7065 10.145 5.7065Z"
              fill="currentColor"
            ></path>
          </svg>
          Changes need to live somewhere stable and be easy to find later
        </CalloutItem>
        <CalloutItem
          title="Proactive"
          variant="info"
          iconStyle="filled"
        >
          <svg
            slot="icon"
            width="20"
            height="20"
            viewBox="0 0 21 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M18.1404 2.07577C18.0422 1.99094 17.9227 1.93452 17.7947 1.9126C17.6668 1.89067 17.5353 1.90406 17.4144 1.95134L1.35205 8.23728C1.12441 8.32579 0.93169 8.48587 0.802896 8.6934C0.674103 8.90092 0.616211 9.14468 0.637937 9.38795C0.659663 9.63123 0.759831 9.86087 0.92336 10.0423C1.08689 10.2237 1.30493 10.3471 1.54465 10.3939L5.70648 11.211V15.8516C5.70566 16.1043 5.78078 16.3515 5.92209 16.5611C6.06341 16.7707 6.26441 16.933 6.49906 17.027C6.73334 17.1226 6.99098 17.1456 7.23849 17.0929C7.48599 17.0402 7.71191 16.9142 7.88686 16.7313L9.89367 14.65L13.0775 17.4367C13.3072 17.6405 13.6034 17.7532 13.9105 17.7538C14.045 17.7537 14.1787 17.7325 14.3067 17.6911C14.5159 17.6248 14.7041 17.5047 14.8525 17.343C15.0009 17.1813 15.1043 16.9835 15.1524 16.7694L18.3695 2.77403C18.3983 2.64782 18.3922 2.51615 18.3518 2.39314C18.3115 2.27013 18.2384 2.16042 18.1404 2.07577ZM13.912 16.4856L7.359 10.7394L16.7907 3.97955L13.912 16.4856Z"
              fill="currentColor"
            ></path>
          </svg>
          Changes need to reach people, not just wait to be found
        </CalloutItem>
      </CalloutList>
    </section>

    <Spacer size="sm" />

    <MetaBox variant="hmw">
      <MetaItem
        label="HOW MIGHT WE"
        value="Make component changes easy to track and retrieve?"
      />
    </MetaBox>

    <Spacer size="lg" />

    <!-- EVALUATION / RESEARCH & CONSTRAINTS -->
    <section class="section">
      <SectionHeader
        id="research"
        eyebrow="Research & Constraints"
        title="A changelog could close the information gap, but no viable solution satisfied our needs and workflow"
      />
      <p class="body-copy">
        I benchmarked 10 Design Systems to see how other teams tracked
        library evolution. <strong>Changelogs</strong> emerged as the most
        common approach.
      </p>
      <p class="body-copy">
        I then <strong>evaluated the available options</strong> against the
        teams' needs and feedback:
      </p>
      <EvaluationTable options={evaluationOptions} />
      <p class="body-copy">
        No existing option satisfied <strong>retrievability</strong>,{" "}
        <strong>frictionless input</strong> and <strong>proactive
        communication</strong> at the same time.
      </p>
      <MetaBox variant="decision">
        <MetaItem
          label="DESIGN DECISION"
          value="Forcing a tool that didn't fit our workflow would only add friction. The only option left was to build something custom around how the team actually worked."
        />
      </MetaBox>
    </section>

    <Spacer size="lg" />

    <!-- STRATEGY -->
    <section class="section">
      <SectionHeader
        id="strategy"
        eyebrow="Strategy"
        title="I used AI as an accelerator to explore, test, and choose based on data"
      />
      <p class="body-copy">
        This was a <strong>new and technical domain</strong> for me, and I{" "}
        <strong>didn't have a developer on the project</strong>. To move fast
        without cutting corners, I used AI as an accelerator to build and
        test different directions myself.
      </p>
      <p class="body-copy">
        I set <strong>lightweight requirements</strong> based on the team's
        goals and needs, then <strong>explored different directions with
        AI</strong>. I evaluated each one with <strong>UI designers in real
        usage</strong> and iterated constantly. That let me try
        <strong> divergent solutions</strong>, for example an automatic
        detection script versus a manual form, and pick the one the data
        supported.
      </p>
      <StrategyFlow />
    </section>

    <Spacer size="lg" />

    <!-- PIVOTS -->
    <section class="section">
      <SectionHeader
        id="pivots"
        eyebrow="Pivots"
        title="From a changelog plugin, to an AI-ready infrastructure"
      />
      <p class="body-copy">
        As I <strong>tested the workflow in real files</strong>, each
        iteration exposed something I hadn't accounted for. These findings
        changed where information should live, how much effort designers
        should spend recording it, and how the system should handle
        data.
      </p>
    </section>

    <Spacer size="md" />

    <div class="pivot-block">
      <h3 class="type-h2" style="color: var(--color-text-heading);">
        01/ Automate what's reliable, ask designers for the rest
      </h3>
      <Confront
        tabs={[
          { label: "Option 1: semi-manual", value: "after", chosen: true },
          { label: "Option 2: automated", value: "before" },
        ]}
      >
        <div data-panel="after" class="pivot-panel">
          <video
            src="/case-studies/design-system-search/form.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          ></video>
        </div>
        <div data-panel="before" class="pivot-panel pivot-panel-centered">
          <img
            src="/case-studies/design-system-search/manually.png"
            alt="Change detector v0.1 prototype: automatic detection listing every node change with a per-row request to add context"
          />
        </div>
      </Confront>
      <p class="body-copy">
        <strong>Initial approach:</strong> I wanted zero friction for
        designers. My first attempt was a detection script that scanned the
        files and logged changes automatically, then asked the designer to
        fill in only the missing context.
      </p>
      <p class="body-copy">
        <strong>Evidence:</strong> The script wasn't reliable on complex
        files (missed real changes, flagged meaningless ones), and even
        when it worked it still lacked the "why" only designers can give:
        the project, and the reason.
      </p>
      <p class="body-copy">
        <strong>Pivot:</strong> I moved to a semi-manual approach: a form
        in the plugin guides designers through all the required info.
        Automation handles the reliable stuff (date, author, component
        sheets), designers add project details.
      </p>
    </div>

    <Spacer size="md" />

    <div class="pivot-block">
      <h3 class="type-h2" style="color: var(--color-text-heading);">
        02/ Put changes where designers see them
      </h3>
      <Confront
        tabs={[
          { label: "AFTER", value: "after" },
          { label: "BEFORE", value: "before" },
        ]}
      >
        <div data-panel="after" class="pivot-panel">
          <video
            src="/case-studies/design-system-search/evolution.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          ></video>
        </div>
        <div data-panel="before" class="pivot-panel">
          <Pivot2BeforeSchema />
        </div>
      </Confront>
      <p class="body-copy">
        <strong>Evidence:</strong> The changelog was now available per
        component in each library, but designers didn't consult it as they
        pulled components straight from the asset panel while working on
        Figma files.
      </p>
      <p class="body-copy">
        <strong>Pivot:</strong> Version info is now written automatically
        into the component's description, so it's visible to everyone. A
        warning icon on component's titles help designers notice an evolution
        at a glance.
      </p>
    </div>

    <Spacer size="md" />

    <div class="pivot-block">
      <h3 class="type-h2" style="color: var(--color-text-heading);">
        03/ Create a reliable source of truth
      </h3>
      <Confront
        tabs={[
          { label: "AFTER", value: "after" },
          { label: "BEFORE", value: "before" },
        ]}
      >
        <div data-panel="after" class="pivot-panel">
          <video
            src="/case-studies/design-system-search/pivot3.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          ></video>
        </div>
        <div data-panel="before" class="pivot-panel pivot-panel-centered pivot-panel-shrink">
          <img
            src="/case-studies/design-system-search/pivot3-before.png"
            alt="Before pivot 3: Figma as source of truth for changelog data"
          />
        </div>
      </Confront>
      <p class="body-copy">
        <strong>Evidence:</strong> With Figma as source of truth for the
        changelog data, changes often got overwritten because multiple
        designers were using the plugin at the same time. It was also
        impossible to know which changes had already been sent to Slack,
        leading to duplication or lost data.
      </p>
      <p class="body-copy">
        <strong>Exploration:</strong> I looked at ways to save the data
        reliably. I considered RAG databases and tested different{" "}
        <strong>GitHub</strong> configurations, weighing each option by{" "}
        <strong>effort</strong>, <strong>time</strong> and{" "}
        <strong>result</strong>.
      </p>
      <p class="body-copy">
        <strong>Pivot:</strong> I chose <strong>GitHub</strong> to sync
        the data on as the best effort-to-result ratio for this phase of
        the project. Moreover, the data saved there can feed AI features
        like changelog search and automatic release notes.
      </p>
    </div>

    <Spacer size="lg" />

    <!-- SOLUTION -->
    <section class="section">
      <SectionHeader
        id="solution"
        eyebrow="Solution"
        title="A system that captures, retrieves, and distributes information where needed"
      />
      <div class="solution-flow-bleed">
        <SolutionFlow />
      </div>
    </section>

    <Spacer size="lg" />

    <!-- IMPACT -->
    <section class="section">
      <SectionHeader
        id="impact"
