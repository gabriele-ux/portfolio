---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import HeroCover from "../../components/HeroCover.astro";
import TagList from "../../components/TagList.astro";
import MetaBox from "../../components/MetaBox.astro";
import MetaItem from "../../components/MetaItem.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import TabCard from "../../components/TabCard.astro";
import Media from "../../components/Media.astro";
import CalloutList from "../../components/CalloutList.astro";
import CalloutItem from "../../components/CalloutItem.astro";
import PrioritizationMatrix from "../../components/PrioritizationMatrix.astro";
import ImpactCard from "../../components/ImpactCard.astro";
import Spacer from "../../components/Spacer.astro";
import CaseStudyNav from "../../components/CaseStudyNav.astro";
import CaseStudyFooter from "../../components/CaseStudyFooter.astro";
import FeatureShowcase from "../../components/FeatureShowcase.astro";

const solutionPreviewFeatures = [
  {
    id: "capture",
    name: "Capture",
    caption:
      "Pick the component, choose the type of change and write why. Author and date are added for you.",
    src: "/case-studies/design-system-search/form.mp4",
  },
  {
    id: "sync",
    name: "Sync",
    caption:
      "New entries wait in a queue. Check, edit or delete them before syncing.",
    src: "/case-studies/design-system-search/sync.mp4",
  },
  {
    id: "release-note",
    name: "Release note",
    caption:
      "TODO — caption and video asset to be added for the Release note tab.",
    src: "/case-studies/design-system-search/pivot3.mp4",
  },
  {
    id: "search",
    name: "Search",
    caption:
      "Each component gets its own history on GitHub, easy to find later.",
    src: "/case-studies/design-system-search/pivot3.mp4",
  },
];

const matrixItems = [
  {
    id: "figma-tracking",
    title: "Track on Figma",
    x: 90,
    y: 14,
    needs: { frictionless: true, retrievable: false, proactive: false },
    rows: [
      { type: "check" as const, text: "Already in the workflow" },
      {
        type: "cross" as const,
        text: "Require to search manually each page to find information",
        emphasis: "fails: easy to find + shared",
      },
    ],
  },
  {
    id: "figma-release-notes",
    title: "Figma Release Notes",
    x: 66,
    y: 30,
    needs: { frictionless: true, retrievable: false, proactive: false },
    rows: [
      { type: "check" as const, text: "Native in the tool" },
      {
        type: "cross" as const,
        text: "Not tied to individual components, and not searchable",
        emphasis: "fails: easy to find + shared",
      },
    ],
  },
  {
    id: "community-plugins",
    title: "Community Plugins",
    x: 84,
    y: 42,
    needs: { frictionless: true, retrievable: false, proactive: false },
    rows: [
      { type: "check" as const, text: "Already integrated in Figma" },
      {
        type: "cross" as const,
        text: "None allowed to easily retrieve information",
        emphasis: "fails: easy to find + shared",
      },
    ],
  },
  {
    id: "zeroheight",
    title: "Zeroheight",
    x: 20,
    y: 78,
    needs: { frictionless: false, retrievable: true, proactive: true },
    rows: [
      {
        type: "check" as const,
        text: "Changelog and release notes out of the box",
      },
      {
        type: "cross" as const,
        text: "Another touchpoint to maintain",
        emphasis: "fails: inside Figma",
      },
    ],
  },
];

const navSections = [
  { id: "overview", label: "Overview" },
  { id: "solution-preview", label: "Solution" },
  { id: "problem", label: "Problem" },
  { id: "process", label: "Process" },
  { id: "plugin-design", label: "Design decisions" },
  { id: "impact", label: "Impact" },
  { id: "learning", label: "Learning" },
];

const title =
  "I built a workflow + plugin that got 85% of library updates logged";

const heroTags = [
  { label: "Shipped", dot: "success" as const },
  { label: "Design System" },
  { label: "Internal tool" },
];

const cover = "/case-studies/design-system-search/cover-changelog.png";
---

<CaseStudyLayout title={title}>
  <div class="case-study-body">
    <CaseStudyNav sections={navSections} />

    <article class="case-study">
      <Spacer size="sm" />

      <!-- HERO CONTENT: chips → title -->
      <section class="hero-content">
        <TagList size="sm" tags={heroTags} />
        <h1 class="type-display" style="color: var(--color-text-heading);">
          {title}
        </h1>
      </section>

      <Spacer size="sm" />

      <!-- HERO IMAGE: cover centrata e con bordi arrotondati -->
      <HeroCover
        src={cover}
        alt="Changelog Manager — case study cover"
        class="hero-cover-rounded"
      />

      <Spacer size="lg" />

      <!-- OVERVIEW: context + problem side-by-side, my role full-width below -->
      <section class="section" id="overview">
        <p class="eyebrow-line">Overview</p>
        <div class="overview-grid">
          <div class="overview-card">
            <small>Context</small>
            <p>
              I'm one of three designers on a central <strong>Design System team</strong> serving <strong>5+ brands</strong>. Product designers across many projects build on our libraries, and some maintain their own UI kits on top of them, so every change spreads fast and is hard to trace.
            </p>
          </div>
          <div class="overview-card">
            <small>Problem</small>
            <p>
              There was no single, reliable record of what changed in the system and why. Over a year, <strong>33 of 273 support requests</strong> were about exactly this. Some took a full day to investigate, and outdated components risked reaching production.
            </p>
          </div>
          <div class="overview-card overview-card--full">
            <small>My role</small>
            <p>
              I owned this <strong>6-week project</strong> end to end, from research to shipping a <strong>change-tracking system</strong> that logs component updates through a Figma plugin, stores their history on GitHub, makes past changes searchable and automatically generates release notes. Built with Figma, Claude Code and GitHub.
            </p>
          </div>
        </div>
      </section>

      <Spacer size="lg" />

      <!-- THE SOLUTION — preview with final feature videos + hero metrics -->
      <section class="section" id="solution-preview">
        <SectionHeader
          eyebrow="The solution"
          title="A workflow and a plugin to track changes and keep teams aligned"
        />
        <FeatureShowcase features={solutionPreviewFeatures} />
        <div class="impact-row">
          <ImpactCard
            metricValue={85}
            metricSuffix="%"
            description="of library updates come with a changelog entry"
          />
          <ImpactCard
            metricPrefix="~"
            metricValue={5}
            metricSuffix="min"
            arrowDirection="down"
            description="to find out why a component changed, down from up to a full day"
          />
          <ImpactCard
            metricValue={1}
            metricSuffix="source"
            arrow={false}
            description="instead of Slack, email and meetings. The source is AI-Ready."
          />
        </div>
      </section>

      <Spacer size="lg" />

      <!-- PROBLEM -->
      <section class="section" id="problem">
        <SectionHeader
          eyebrow="Problem"
          title="Component changes were becoming harder to manage"
        />
      </section>

      <Spacer size="xs" />

      <div class="sub-block">
        <p class="body-copy">
          As more designers worked across <strong>Design System libraries and product UI Kits</strong>, keeping track of component changes became <strong>increasingly difficult</strong>. Over one year, <strong>33 of 273 support requests</strong> were related to component changes or versions. I mapped the flow, and talked to designers and found:
        </p>

        <Spacer size="sm" />

        <div class="problem-wrap">
          <table class="problem-table">
            <colgroup>
              <col class="col-index" />
              <col class="col-theme" />
              <col class="col-problem" />
              <col class="col-arrow" />
              <col class="col-consequence" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col" aria-label="Number"></th>
                <th scope="col">Theme</th>
                <th scope="col">Problem</th>
                <th scope="col" aria-hidden="true"></th>
                <th scope="col">Consequence</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="problem-index">01</td>
                <td><span class="problem-theme">Tracking</span></td>
                <td class="problem-text">Changes happened across libraries with no shared record</td>
                <td class="problem-arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </td>
                <td class="consequence-text">Designers risked using outdated components or duplicating work</td>
              </tr>
              <tr>
                <td class="problem-index">02</td>
                <td><span class="problem-theme">Communication</span></td>
                <td class="problem-text">Updates travelled through Slack, email and meetings</td>
                <td class="problem-arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </td>
                <td class="consequence-text">Other designers missed changes that affected their work</td>
              </tr>
              <tr>
                <td class="problem-index">03</td>
                <td><span class="problem-theme">Discoverability</span></td>
                <td class="problem-text">Finding a component's history meant asking colleagues</td>
                <td class="problem-arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </td>
                <td class="consequence-text">Answering a single question could take up to a full day</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <Spacer size="lg" />

      <!-- PROCESS -->
      <section class="section" id="process">
        <SectionHeader
          eyebrow="Process"
          title="From scattered updates to a shared process"
        />
      </section>

      <Spacer size="xs" />

      <div class="process-step">
        <span class="process-step-number" aria-hidden="true">01</span>
        <div class="process-step-body">
          <h3 class="process-step-title">A changelog could solve the issue, but had to be maintained</h3>
          <p class="body-copy">
            I benchmarked <strong>10 design systems</strong> and found that most relied on a central team to manage changelogs, mainly for code changes. In our case, Product Designers also edited components in their own Figma UI Kits, so changes needed to be tracked across multiple libraries and projects.
          </p>
          <p class="body-copy">
            I ran a session with the <strong>8 designers</strong> to understand what would <strong>make logging changes simple</strong> enough to become part of their routine. We agreed on three requirements:
          </p>
          <CalloutList>
          <CalloutItem
            title="Inside Figma"
            variant="info"
            iconStyle="filled"
          >
            <svg
              slot="icon"
              width="20"
              height="20"
              viewBox="0 0 21 21"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M16.9493 9.94365L8.07237 19.4546C7.9783 19.555 7.85413 19.622 7.7186 19.6457C7.58307 19.6693 7.44353 19.6482 7.32103 19.5856C7.19854 19.5229 7.09974 19.4222 7.03954 19.2985C6.97935 19.1748 6.96103 19.0348 6.98734 18.8998L8.14926 13.0878L3.58163 11.3727C3.48353 11.336 3.39605 11.2755 3.32701 11.1968C3.25796 11.118 3.2095 11.0234 3.18595 10.9214C3.1624 10.8193 3.16449 10.713 3.19205 10.612C3.2196 10.5109 3.27176 10.4183 3.34385 10.3423L12.2207 0.831376C12.3148 0.730984 12.439 0.663913 12.5745 0.640283C12.71 0.616653 12.8496 0.637746 12.9721 0.70038C13.0946 0.763013 13.1934 0.863789 13.2536 0.987499C13.3138 1.11121 13.3321 1.25114 13.3058 1.38618L12.1407 7.2045L16.7083 8.91726C16.8057 8.9542 16.8925 9.01455 16.961 9.09299C17.0295 9.17143 17.0776 9.26554 17.1011 9.367C17.1246 9.46846 17.1228 9.57414 17.0957 9.67471C17.0687 9.77529 17.0173 9.86765 16.9461 9.94365H16.9493Z"
                fill="currentColor"
              ></path>
            </svg>
            Designers shouldn't have to switch tools to log a change.
          </CalloutItem>
          <CalloutItem
            title="Easy to find"
            variant="info"
            iconStyle="outlined"
          >
            <svg
              slot="icon"
              width="20"
              height="20"
              viewBox="0 0 21 21"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M10.145 1.26807C8.29586 1.27016 6.52304 2.00567 5.21549 3.31322C3.90794 4.62078 3.17243 6.3936 3.17033 8.24275C3.17033 14.2109 9.51096 18.7183 9.78123 18.9069C9.88784 18.9816 10.0149 19.0216 10.145 19.0216C10.2752 19.0216 10.4022 18.9816 10.5088 18.9069C10.7791 18.7183 17.1197 14.2109 17.1197 8.24275C17.1176 6.3936 16.3821 4.62078 15.0746 3.31322C13.767 2.00567 11.9942 1.27016 10.145 1.26807ZM10.145 5.7065C10.6466 5.7065 11.137 5.85525 11.5541 6.13394C11.9712 6.41263 12.2962 6.80873 12.4882 7.27217C12.6802 7.73561 12.7304 8.24557 12.6325 8.73755C12.5347 9.22954 12.2931 9.68145 11.9384 10.0362C11.5837 10.3909 11.1318 10.6324 10.6398 10.7303C10.1478 10.8281 9.63788 10.7779 9.17444 10.5859C8.711 10.394 8.31489 10.0689 8.03621 9.65182C7.75752 9.23474 7.60877 8.74438 7.60877 8.24275C7.60877 7.5701 7.87598 6.92499 8.35162 6.44935C8.82726 5.97372 9.47237 5.7065 10.145 5.7065Z"
                fill="currentColor"
              ></path>
            </svg>
            All past changes should be available in one place.
          </CalloutItem>
          <CalloutItem
            title="Shared"
            variant="info"
            iconStyle="filled"
          >
            <svg
              slot="icon"
              width="20"
              height="20"
              viewBox="0 0 21 21"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18.1404 2.07577C18.0422 1.99094 17.9227 1.93452 17.7947 1.9126C17.6668 1.89067 17.5353 1.90406 17.4144 1.95134L1.35205 8.23728C1.12441 8.32579 0.93169 8.48587 0.802896 8.6934C0.674103 8.90092 0.616211 9.14468 0.637937 9.38795C0.659663 9.63123 0.759831 9.86087 0.92336 10.0423C1.08689 10.2237 1.30493 10.3471 1.54465 10.3939L5.70648 11.211V15.8516C5.70566 16.1043 5.78078 16.3515 5.92209 16.5611C6.06341 16.7707 6.26441 16.933 6.49906 17.027C6.73334 17.1226 6.99098 17.1456 7.23849 17.0929C7.48599 17.0402 7.71191 16.9142 7.88686 16.7313L9.89367 14.65L13.0775 17.4367C13.3072 17.6405 13.6034 17.7532 13.9105 17.7538C14.045 17.7537 14.1787 17.7325 14.3067 17.6911C14.5159 17.6248 14.7041 17.5047 14.8525 17.343C15.0009 17.1813 15.1043 16.9835 15.1524 16.7694L18.3695 2.77403C18.3983 2.64782 18.3922 2.51615 18.3518 2.39314C18.3115 2.27013 18.2384 2.16042 18.1404 2.07577ZM13.912 16.4856L7.359 10.7394L16.7907 3.97955L13.912 16.4856Z"
                fill="currentColor"
              ></path>
            </svg>
            Relevant updates should reach the teams affected by them.
          </CalloutItem>
        </CalloutList>
        <p class="type-caption needs-label">
          <svg
            class="needs-label-arrow"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="12" y1="19" x2="12" y2="5" />
            <polyline points="5 12 12 5 19 12" />
          </svg>
          <span>The needs of our team</span>
        </p>
        </div>
      </div>

      <div class="process-step">
        <span class="process-step-number" aria-hidden="true">02</span>
        <div class="process-step-body">
          <h3 class="process-step-title">None of the tools we tested fit our needs</h3>
          <p class="body-copy">
            I compared <strong>4 existing tools</strong> against these requirements, looking at how easily designers could log changes, find past updates and work within their existing workflow.
          </p>
          <PrioritizationMatrix items={matrixItems} />
          <MetaBox variant="decision">
            <MetaItem label="DECISION">
              No tool covered all three needs, so I proposed we <strong>build our own Figma plugin</strong>. More maintenance for us, but any external tool would bring back the step people kept skipping.
            </MetaItem>
          </MetaBox>
        </div>
      </div>

      <div class="process-step">
        <span class="process-step-number" aria-hidden="true">03</span>
        <div class="process-step-body">
          <h3 class="process-step-title">The plugin was only half the solution</h3>
          <p class="body-copy">
            A plugin alone wouldn't change how designers worked. If logging changes remained optional, it could easily be skipped again.
          </p>
          <p class="body-copy">
            Together with the designers, I introduced a simple rule: every new or updated component had to be logged before publishing the library. We also agreed to send a weekly email with the changes to the three product teams.
          </p>
        </div>
      </div>

      <Spacer size="lg" />

      <!-- 03 DESIGN DECISIONS -->
      <section class="section" id="plugin-design">
        <SectionHeader
          eyebrow="Design decisions"
          title="Four choices that shaped how designers use it"
        />
      </section>

      <Spacer size="xs" />

      <!-- 03.a Guided form -->
      <div class="pivot-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          A guided form, not a blank page
        </h3>
        <p class="body-copy">
          I tested three options: a manual table, automatic detection and a guided form. The form worked best. The plugin fills in the name, date and author. Designers only write what nobody else knows: why they made the change.
        </p>
        <TabCard
          ariaLabel="Input approach"
          tabs={[
            { label: "Guided form", value: "guided" },
            { label: "Automatic detection", value: "auto" },
            { label: "Manual table", value: "manual" },
          ]}
        >
          <div slot="guided" class="acc-content-group">
            <div class="todo-placeholder">
              <span class="todo-label">TODO — Asset</span>
              <div class="todo-body">
                <strong>Guided form (plugin design view)</strong>
                <p>Static shot of the form, different from the video used in the Solution preview.</p>
              </div>
            </div>
            <p class="body-copy">
              The plugin asks designers only for the context nobody else has: why the change was made.
            </p>
          </div>
          <div slot="auto" class="acc-content-group">
            <div class="pivot-panel pivot-panel-centered">
              <img
                src="/case-studies/design-system-search/manually.png"
                alt="Change detector prototype: automatic detection listing every node change with a per-row request to add context"
              />
            </div>
            <p class="body-copy">
              On complex files it missed meaningful changes, flagged irrelevant edits and still could not capture why a change had been made.
            </p>
          </div>
          <div slot="manual" class="acc-content-group">
            <div class="pivot-panel pivot-panel-centered">
              <img
                src="/case-studies/design-system-search/manual.png"
                alt="Manual table under each component that designers fill in by hand"
              />
            </div>
            <p class="body-copy">
              Designers entered only the minimum information and often missed useful context.
            </p>
          </div>
        </TabCard>
      </div>

      <Spacer size="sm" />

      <!-- 03.b A queue to see what is pending -->
      <div class="sub-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          A queue to see what is pending
        </h3>
        <p class="body-copy">
          During testing, designers didn't know which changes were already synced. The queue shows what is waiting, and they can edit or delete entries before publishing.
        </p>
        <div class="todo-placeholder">
          <span class="todo-label">TODO — Asset</span>
          <div class="todo-body">
            <strong>What designers saw before the queue</strong>
            <p>Visual showing the uncertainty before the queue was introduced.</p>
          </div>
        </div>
      </div>

      <Spacer size="sm" />

      <!-- 03.c Setup without asking for help -->
      <div class="sub-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          Setup without asking for help
        </h3>
        <p class="body-copy">
          At first, setup needed technical steps that designers couldn't do alone. I cut it down to the basics and automated the rest.
        </p>
        <div class="todo-placeholder">
          <span class="todo-label">TODO — Asset</span>
          <div class="todo-body">
            <strong>Setup before and after</strong>
            <p>Side-by-side of the old technical setup and the simplified onboarding.</p>
          </div>
        </div>
      </div>

      <Spacer size="sm" />

      <!-- 03.d Infrastructure that opens to AI and data analysis -->
      <div class="sub-block">
        <h3 class="type-h2" style="color: var(--color-text-heading);">
          An infrastructure that opens doors for AI and data analysis
        </h3>
        <p class="body-copy">
          Each component has its own Markdown file on GitHub. It's easy to read and keeps a full history. A more complex database was too much for six weeks, but Markdown is enough to <strong>plug in AI</strong> on top later (semantic search, summaries of what changed) and to <strong>run data analysis</strong> on how often each component moves, who edits what, and where friction concentrates.
        </p>
      </div>

      <Spacer size="lg" />

      <!-- IMPACT -->
      <section class="section" id="impact">
        <SectionHeader
          eyebrow="Impact"
          title="After 12 weeks, 85% of library updates had a changelog entry"
        />
        <p class="body-copy">
          Most changes are now logged, and finding the reason behind one takes minutes.
        </p>
        <div class="impact-bento">
          <ImpactCard
            class="bento-wide"
            metricValue={7}
            metricSuffix="/ 8 designers"
            arrow={false}
            description="log their changes"
          />
          <ImpactCard
            metricValue={85}
            metricSuffix="%"
            arrow={false}
            description="of library updates come with a changelog entry"
          />
          <ImpactCard
            metricPrefix="~"
            metricValue={5}
            metricSuffix="min"
            arrowDirection="down"
            description="to find out why a component changed, down from up to a full day"
          />
          <ImpactCard
            metricValue={1}
            metricSuffix="source of truth"
            arrow={false}
            description="instead of Slack, email and meetings"
          />
          <ImpactCard
            metricValue={1}
            metricSuffix="weekly email"
            arrow={false}
            description="with all changes, sent to three teams"
          />
        </div>
        <Spacer size="xs" />

        <div class="sub-block">
          <h3 class="type-h2" style="color: var(--color-text-heading);">
            What I want to measure next
          </h3>
          <ul class="criteria-list">
            <li>
              <strong>Support requests:</strong> 12 weeks is too short to see a real change. After 6 months, I'll repeat the ticket analysis with the same categories and compare it with the 12% we started from.
            </li>
            <li>
              <strong>Outdated components:</strong> I'll use Figma library analytics to see how often teams use old versions or detach components. If people hear about changes in time, this should go down.
            </li>
          </ul>
        </div>
      </section>

