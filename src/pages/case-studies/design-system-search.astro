---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import HeroCover from "../../components/HeroCover.astro";
import TagList from "../../components/TagList.astro";
import MetaBox from "../../components/MetaBox.astro";
import MetaItem from "../../components/MetaItem.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Media from "../../components/Media.astro";
import TransitionCallout from "../../components/TransitionCallout.astro";
import CalloutList from "../../components/CalloutList.astro";
import CalloutItem from "../../components/CalloutItem.astro";
import OptionCardList from "../../components/OptionCardList.astro";
import OptionCard from "../../components/OptionCard.astro";
import OptionRow from "../../components/OptionRow.astro";
import Confront from "../../components/Confront.astro";
import Spacer from "../../components/Spacer.astro";
import CaseStudyNav from "../../components/CaseStudyNav.astro";

const navSections = [
  { id: "background", label: "The Background" },
  { id: "problem", label: "The Problem" },
  { id: "discovery", label: "Discovery" },
  { id: "research", label: "Research & Constraints" },
  { id: "strategy", label: "Strategy" },
  { id: "pivots", label: "Pivots" },
  { id: "solution", label: "Solution" },
  { id: "impact", label: "Impact" },
  { id: "learnings", label: "Learnings" },
];

const title =
  "I turned fragmented Design System changes into a shared, searchable source of truth";

const heroTags = [
  { label: "Shipped", dot: "success" as const },
  { label: "Design System" },
  { label: "UX" },
  { label: "UI" },
];

const heroMeta = [
  { label: "ROLE", value: "Full end-to-end ownership" },
  { label: "TIMELINE", value: "6 weeks" },
  {
    label: "TECHNIQUES",
    value:
      "Data Analysis, Benchmark, Interviews, Flow Mapping, Prototyping, User Tests",
  },
  { label: "TOOLS", value: "Claude Code, Figjam" },
];

const cover = "/playground/placeholder.svg";
---

<CaseStudyLayout title={title}>
  <HeroCover src={cover} alt="Case study cover" />

  <div class="case-study-body">
    <CaseStudyNav sections={navSections} />

    <article class="case-study">
    <Spacer size="md" />

    <section class="hero-content">
      <h1 class="type-display" style="color: var(--color-text-heading);">
        {title}
      </h1>
      <TagList tags={heroTags} />
    </section>

    <Spacer size="sm" />

    <MetaBox>
      {heroMeta.map((m) => <MetaItem label={m.label} value={m.value} />)}
    </MetaBox>

    <Spacer size="lg" />

    <!-- BACKGROUND -->
    <section class="section">
      <SectionHeader
        id="background"
        eyebrow="The background"
        title="One complex system growing at different speed"
      />
      <p class="body-copy">
        I'm part of a <strong>3-person Design System team</strong>, still
        fairly new. We maintain <strong>4 core libraries</strong>; UI
        designers use them across different products. The governance system
        was slowly built over the past years. There's still a lot to figure
        out, and I joined while it was taking shape.
      </p>
      <p class="body-copy">
        Every project runs on its own timeline, so at any given moment,
        different designers can be working with{" "}
        <strong>different versions of the same component, all at once</strong>.
        That much movement naturally creates entropy. Our job is to fight it:{" "}
        <strong>rationalize, simplify, keep things fast</strong>.
      </p>
      <Media
        src="/case-studies/design-system-search/diagram-teams.jpg"
        alt="Applications and product teams responsibilities diagram"
        caption="TEAMS' RESPONSABILITIES AND INTERACTION"
      />
    </section>

    <Spacer size="lg" />

    <!-- PROBLEM -->
    <section class="section">
      <SectionHeader
        id="problem"
        eyebrow="Problem"
        title="The design system team was turning into a help desk"
      />
      <p class="body-copy">
        Even though we had a process to communicate updates, the{" "}
        <strong>same questions kept coming back</strong>:
      </p>
      <Media
        src="/case-studies/design-system-search/diagram-questions.jpg"
        alt="Recurring questions from designers"
      />
      <MetaBox variant="data">
        <MetaItem label="TICKET ANALYSIS - 1 YEAR PERIOD">
          <strong>12%</strong> of <strong>273</strong> requests where about <strong>component changes</strong> or which version to use
        </MetaItem>
      </MetaBox>
    </section>

    <Spacer size="sm" />

    <TransitionCallout
      title="This impacted our work in two ways"
      variant="warning"
    />

    <Spacer size="sm" />

    <!-- PAIN POINTS -->
    <section class="section-tight">
      <p class="eyebrow-line">PAIN POINTS</p>
      <CalloutList>
        <CalloutItem
          title="Hours lost answering questions"
          variant="warning"
          iconStyle="filled"
        >
          <svg
            slot="icon"
            width="20"
            height="20"
            viewBox="0 0 21 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M10.7789 6.34057V9.78591L13.6417 11.5034C13.7859 11.59 13.8898 11.7304 13.9305 11.8936C13.9713 12.0568 13.9455 12.2295 13.8589 12.3737C13.7723 12.5179 13.6319 12.6218 13.4687 12.6625C13.3055 12.7032 13.1328 12.6774 12.9886 12.5908L9.81833 10.6887C9.72449 10.6323 9.64686 10.5526 9.59297 10.4573C9.53908 10.362 9.51077 10.2544 9.51081 10.1449V6.34057C9.51081 6.17241 9.57761 6.01113 9.69652 5.89222C9.81543 5.77331 9.9767 5.70651 10.1449 5.70651C10.313 5.70651 10.4743 5.77331 10.5932 5.89222C10.7121 6.01113 10.7789 6.17241 10.7789 6.34057ZM17.7536 4.43838C17.5855 4.43838 17.4242 4.50519 17.3053 4.6241C17.1864 4.74301 17.1196 4.90428 17.1196 5.07245V6.49909C16.6163 5.91575 16.1027 5.35381 15.5249 4.76889C14.4675 3.71136 13.1219 2.98888 11.6562 2.69174C10.1905 2.3946 8.66976 2.53597 7.28397 3.09819C5.89818 3.6604 4.70879 4.61853 3.86443 5.85285C3.02006 7.08718 2.55817 8.54296 2.53645 10.0383C2.51473 11.5336 2.93415 13.0022 3.74231 14.2605C4.55047 15.5189 5.71153 16.5111 7.08041 17.1133C8.44929 17.7156 9.96528 17.9011 11.439 17.6466C12.9127 17.3922 14.2787 16.7091 15.3664 15.6827C15.4269 15.6254 15.4757 15.5568 15.5097 15.4808C15.5438 15.4047 15.5625 15.3227 15.5649 15.2393C15.5672 15.156 15.5531 15.0731 15.5234 14.9952C15.4937 14.9173 15.449 14.8461 15.3917 14.7855C15.3345 14.7249 15.2659 14.6762 15.1898 14.6421C15.1137 14.6081 15.0317 14.5893 14.9484 14.587C14.8651 14.5846 14.7821 14.5987 14.7042 14.6284C14.6264 14.6581 14.5551 14.7029 14.4945 14.7601C13.5879 15.6146 12.4496 16.183 11.2218 16.3944C9.99397 16.6058 8.73111 16.4508 7.59087 15.9488C6.45064 15.4468 5.48357 14.6199 4.81043 13.5716C4.13729 12.5232 3.78791 11.2998 3.80592 10.0541C3.82393 8.80835 4.20853 7.59553 4.91169 6.56707C5.61485 5.53861 6.60542 4.7401 7.75969 4.27124C8.91395 3.80238 10.1808 3.68396 11.4019 3.93076C12.6231 4.17756 13.7445 4.77864 14.6261 5.65895C15.2713 6.31204 15.8364 6.94135 16.4062 7.6087H14.5833C14.4151 7.6087 14.2539 7.6755 14.135 7.79441C14.016 7.91332 13.9492 8.07459 13.9492 8.24276C13.9492 8.41092 14.016 8.5722 14.135 8.69111C14.2539 8.81002 14.4151 8.87682 14.5833 8.87682H17.7536C17.9218 8.87682 18.0831 8.81002 18.202 8.69111C18.3209 8.5722 18.3877 8.41092 18.3877 8.24276V5.07245C18.3877 4.90428 18.3209 4.74301 18.202 4.6241C18.0831 4.50519 17.9218 4.43838 17.7536 4.43838Z"
              fill="currentColor"
            ></path>
          </svg>
          In the last year, our team spent up to a day for each question to
          recover the info on changes trough slack, email, and asking around
        </CalloutItem>
        <CalloutItem
          title="Risk of using wrong components"
          variant="warning"
          iconStyle="outlined"
        >
          <svg
            slot="icon"
            width="20"
            height="20"
            viewBox="0 0 21 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M18.6517 9.25107L11.039 1.63756C10.8014 1.40137 10.48 1.2688 10.1449 1.2688C9.80993 1.2688 9.48852 1.40137 9.25092 1.63756L1.64217 9.25107C1.40598 9.48866 1.27341 9.81007 1.27341 10.1451C1.27341 10.4801 1.40598 10.8015 1.64217 11.0391L9.25488 18.6526C9.49248 18.8888 9.81389 19.0214 10.1489 19.0214C10.4839 19.0214 10.8053 18.8888 11.0429 18.6526L18.6557 11.0391C18.8918 10.8015 19.0244 10.4801 19.0244 10.1451C19.0244 9.81007 18.8918 9.48866 18.6557 9.25107H18.6517ZM9.51088 6.34072C9.51088 6.17255 9.57769 6.01128 9.6966 5.89237C9.81551 5.77346 9.97678 5.70666 10.1449 5.70666C10.3131 5.70666 10.4744 5.77346 10.5933 5.89237C10.7122 6.01128 10.779 6.17255 10.779 6.34072V10.7792C10.779 10.9473 10.7122 11.1086 10.5933 11.2275C10.4744 11.3464 10.3131 11.4132 10.1449 11.4132C9.97678 11.4132 9.81551 11.3464 9.6966 11.2275C9.57769 11.1086 9.51088 10.9473 9.51088 10.7792V6.34072ZM10.1449 14.5835C9.95684 14.5835 9.77295 14.5277 9.61655 14.4232C9.46014 14.3187 9.33824 14.1702 9.26625 13.9964C9.19426 13.8226 9.17543 13.6314 9.21213 13.4469C9.24883 13.2624 9.33941 13.0929 9.47242 12.9599C9.60544 12.8269 9.7749 12.7363 9.9594 12.6996C10.1439 12.6629 10.3351 12.6818 10.5089 12.7537C10.6827 12.8257 10.8312 12.9476 10.9358 13.104C11.0403 13.2604 11.096 13.4443 11.096 13.6324C11.096 13.8847 10.9958 14.1266 10.8175 14.305C10.6391 14.4833 10.3972 14.5835 10.1449 14.5835Z"
              fill="currentColor"
            ></path>
          </svg>
          Designers struggled to pick the right version for each project,
          risking outdated components in their flows, and having to replace
          them later
        </CalloutItem>
      </CalloutList>
    </section>

    <Spacer size="sm" />

    <p class="body-copy">
      We already had a process to communicate changes but{" "}
      <strong>it wasn't working</strong>. I needed to find out why.
    </p>

    <Spacer size="lg" />

    <!-- DISCOVERY -->
    <section class="section">
      <SectionHeader
        id="discovery"
        eyebrow="Discovery"
        title="There was no visibility into changes on the libraries"
      />
      <p class="body-copy">
        To understand why, I <strong>audited the workflows</strong>, and{" "}
        <strong>interviewed everyone</strong> that worked with the design
        system.
      </p>
      <Media
        src="/case-studies/design-system-search/discovery.jpg"
        alt="Actual workflow between UX/UI and Design System teams"
        caption="THE ACTUAL WORKFLOW AND THE MAJOR PAINT POINT"
      />
    </section>

    <Spacer size="sm" />

    <MetaBox variant="insight">
      <MetaItem
        label="INSIGHT"
        value="Changes were communicated, but there was no shared source of truth for tracking and retrieving them."
      />
    </MetaBox>

    <Spacer size="sm" />

    <TransitionCallout
      title="I defined project objectives to guide the design phase"
      variant="info"
    />

    <Spacer size="sm" />

    <!-- OUR NEEDS -->
    <section class="section-tight">
      <p class="eyebrow-line">OUR NEEDS</p>
      <CalloutList>
        <CalloutItem
          title="Retrievabile"
          variant="info"
          iconStyle="filled"
        >
          <svg
            slot="icon"
            width="20"
            height="20"
            viewBox="0 0 21 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M10.145 1.26807C8.29586 1.27016 6.52304 2.00567 5.21549 3.31322C3.90794 4.62078 3.17243 6.3936 3.17033 8.24275C3.17033 14.2109 9.51096 18.7183 9.78123 18.9069C9.88784 18.9816 10.0149 19.0216 10.145 19.0216C10.2752 19.0216 10.4022 18.9816 10.5088 18.9069C10.7791 18.7183 17.1197 14.2109 17.1197 8.24275C17.1176 6.3936 16.3821 4.62078 15.0746 3.31322C13.767 2.00567 11.9942 1.27016 10.145 1.26807ZM10.145 5.7065C10.6466 5.7065 11.137 5.85525 11.5541 6.13394C11.9712 6.41263 12.2962 6.80873 12.4882 7.27217C12.6802 7.73561 12.7304 8.24557 12.6325 8.73755C12.5347 9.22954 12.2931 9.68145 11.9384 10.0362C11.5837 10.3909 11.1318 10.6324 10.6398 10.7303C10.1478 10.8281 9.63788 10.7779 9.17444 10.5859C8.711 10.394 8.31489 10.0689 8.03621 9.65182C7.75752 9.23474 7.60877 8.74438 7.60877 8.24275C7.60877 7.5701 7.87598 6.92499 8.35162 6.44935C8.82726 5.97372 9.47237 5.7065 10.145 5.7065Z"
              fill="currentColor"
            ></path>
          </svg>
          Changes need to live somewhere stable and be easy to find later
        </CalloutItem>
        <CalloutItem
          title="Frictionless"
          variant="info"
          iconStyle="outlined"
        >
          <svg
            slot="icon"
            width="20"
            height="20"
            viewBox="0 0 21 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M16.9493 9.94365L8.07237 19.4546C7.9783 19.555 7.85413 19.622 7.7186 19.6457C7.58307 19.6693 7.44353 19.6482 7.32103 19.5856C7.19854 19.5229 7.09974 19.4222 7.03954 19.2985C6.97935 19.1748 6.96103 19.0348 6.98734 18.8998L8.14926 13.0878L3.58163 11.3727C3.48353 11.336 3.39605 11.2755 3.32701 11.1968C3.25796 11.118 3.2095 11.0234 3.18595 10.9214C3.1624 10.8193 3.16449 10.713 3.19205 10.612C3.2196 10.5109 3.27176 10.4183 3.34385 10.3423L12.2207 0.831376C12.3148 0.730984 12.439 0.663913 12.5745 0.640283C12.71 0.616653 12.8496 0.637746 12.9721 0.70038C13.0946 0.763013 13.1934 0.863789 13.2536 0.987499C13.3138 1.11121 13.3321 1.25114 13.3058 1.38618L12.1407 7.2045L16.7083 8.91726C16.8057 8.9542 16.8925 9.01455 16.961 9.09299C17.0295 9.17143 17.0776 9.26554 17.1011 9.367C17.1246 9.46846 17.1228 9.57414 17.0957 9.67471C17.0687 9.77529 17.0173 9.86765 16.9461 9.94365H16.9493Z"
              fill="currentColor"
            ></path>
          </svg>
          The solution needs to fit into UX/UI workflow as they will be using
          it in their UI Kits
        </CalloutItem>
        <CalloutItem
          title="Proactive"
          variant="info"
          iconStyle="filled"
        >
          <svg
            slot="icon"
            width="20"
            height="20"
            viewBox="0 0 21 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M18.1404 2.07577C18.0422 1.99094 17.9227 1.93452 17.7947 1.9126C17.6668 1.89067 17.5353 1.90406 17.4144 1.95134L1.35205 8.23728C1.12441 8.32579 0.93169 8.48587 0.802896 8.6934C0.674103 8.90092 0.616211 9.14468 0.637937 9.38795C0.659663 9.63123 0.759831 9.86087 0.92336 10.0423C1.08689 10.2237 1.30493 10.3471 1.54465 10.3939L5.70648 11.211V15.8516C5.70566 16.1043 5.78078 16.3515 5.92209 16.5611C6.06341 16.7707 6.26441 16.933 6.49906 17.027C6.73334 17.1226 6.99098 17.1456 7.23849 17.0929C7.48599 17.0402 7.71191 16.9142 7.88686 16.7313L9.89367 14.65L13.0775 17.4367C13.3072 17.6405 13.6034 17.7532 13.9105 17.7538C14.045 17.7537 14.1787 17.7325 14.3067 17.6911C14.5159 17.6248 14.7041 17.5047 14.8525 17.343C15.0009 17.1813 15.1043 16.9835 15.1524 16.7694L18.3695 2.77403C18.3983 2.64782 18.3922 2.51615 18.3518 2.39314C18.3115 2.27013 18.2384 2.16042 18.1404 2.07577ZM13.912 16.4856L7.359 10.7394L16.7907 3.97955L13.912 16.4856Z"
              fill="currentColor"
            ></path>
          </svg>
          Changes need to reach people, not just wait to be found
        </CalloutItem>
      </CalloutList>
    </section>

    <Spacer size="sm" />

    <MetaBox variant="hmw">
      <MetaItem
        label="HOW MIGHT WE"
        value="Make component changes easy to track and retrieve?"
      />
    </MetaBox>

    <Spacer size="lg" />

    <!-- EVALUATION / RESEARCH & CONSTRAINTS -->
    <section class="section">
      <SectionHeader
        id="research"
        eyebrow="Research & Constraints"
        title="A changelog could close the information gap, but no viable solution satisfied our needs and workflow"
      />
      <p class="body-copy">
        I <strong>benchmarked 10 Design Systems</strong> to understand how
        other teams handled component evolution.
      </p>
      <p class="body-copy">
        <strong>8 used changelogs or release notes</strong> as part of their
        documentation, which confirmed that a changelog was a sensible
        direction.
      </p>
      <p class="body-copy">
        I then <strong>evaluated the available options</strong> against the
        teams' needs and feedback:
      </p>
      <OptionCardList>
        <OptionCard title="1. Track on Figma">
          <OptionRow type="check">Already in the workflow</OptionRow>
          <OptionRow type="cross">
            Require to search manually each page to find information (<em
              >fails: proactive + retrievability</em
            >)
          </OptionRow>
        </OptionCard>
        <OptionCard title="2. Figma Release Note">
          <OptionRow type="check">Native in the tool</OptionRow>
          <OptionRow type="cross">
            Not tied to individual components, and not searchable (<em
              >fails: proactive + retrievability</em
            >)
          </OptionRow>
        </OptionCard>
        <OptionCard title="3. Community Plugins">
          <OptionRow type="check">Already integrated in Figma</OptionRow>
          <OptionRow type="cross">
            None allowed to easily retrieve information (<em
              >fails: proactive + frictionless</em
            >)
          </OptionRow>
        </OptionCard>
        <OptionCard title="4. ZeroHeight">
          <OptionRow type="check">
            Changelog and release notes out of the box
          </OptionRow>
          <OptionRow type="cross">
            Another touchpoint to maintain (<em>fails: frictionless</em>)
          </OptionRow>
        </OptionCard>
      </OptionCardList>
      <MetaBox variant="decision">
        <MetaItem
          label="DESIGN DECISION"
          value="No existing option satisfied our needs, so I chose to develop a custom plugin for Figma."
        />
      </MetaBox>
    </section>

    <Spacer size="lg" />

    <!-- STRATEGY -->
    <section class="section">
      <SectionHeader
        id="strategy"
        eyebrow="Strategy"
        title="I used AI to iterate faster and surface technical constraints"
      />
      <p class="body-copy">
        This was a new domain for me, and I was{" "}
        <strong>designing a software system from scratch</strong> without a
        predefined architecture or dedicated engineering resource. I knew the
        objectives, but not yet how all the technical pieces would fit
        together.
      </p>
      <p class="body-copy">
        I defined lightweight requirements,{" "}
        <strong>used Claude Code to build functional versions of the plugin</strong>,
        tested them in the real workflow, and refined the architecture as I
        learned. This allowed me to make technical and design decisions{" "}
        <strong>based on real usage rather than assumptions</strong>, while
        making the most of the limited time available.
      </p>
    </section>

    <Spacer size="lg" />

    <!-- PIVOTS -->
    <section class="section">
      <SectionHeader
        id="pivots"
        eyebrow="Pivots"
        title="From a changelog plugin, to an AI-ready infrastructure"
      />
      <p class="body-copy">
        As I <strong>tested the workflow in real files</strong>, each
        iteration exposed something I hadn't accounted for. These findings
        changed where information should live, how much effort designers
        should spend recording it, and how the system should handle the
        growing history.
      </p>
    </section>

    <Spacer size="md" />

    <div class="pivot-block">
      <h3 class="type-h2" style="color: var(--color-text-heading);">
        01/ Reduce the effort to log a change
      </h3>
      <Confront
        tabs={[
          { label: "AFTER", value: "after" },
          { label: "BEFORE", value: "before" },
        ]}
      >
        <div
          data-panel="after"
          class="pivot-panel"
          style="background-image: url('/playground/placeholder.svg');"
        >
        </div>
        <div
          data-panel="before"
          class="pivot-panel"
          style="background-image: url('/playground/placeholder.svg');"
        >
        </div>
      </Confront>
      <p class="body-copy">
        <strong>Initial approach:</strong> I didn't know the technology so I
        started simple by adding tables under each component for designers to
        fill in, then the plugin would collect the changes into a list ready
        to be shared on Slack.
      </p>
      <p class="body-copy">
        <strong>Evidence:</strong> Designers filled in the minimum details
        possible. We weren't getting the information we needed and the
        workflow was too demanding.
      </p>
      <p class="body-copy">
        <strong>Pivot:</strong> I introduced a guided form that captured what
        we actually needed, and automated anything that could be automated,
        like creating the table for new components.
      </p>
    </div>

    <Spacer size="md" />

    <div class="pivot-block">
      <h3 class="type-h2" style="color: var(--color-text-heading);">
        02/ Put changes where designers see them
      </h3>
      <Confront
        tabs={[
          { label: "AFTER", value: "after" },
          { label: "BEFORE", value: "before" },
        ]}
      >
        <div
          data-panel="after"
          class="pivot-panel"
          style="background-image: url('/playground/placeholder.svg');"
        >
        </div>
        <div
          data-panel="before"
          class="pivot-panel"
          style="background-image: url('/playground/placeholder.svg');"
        >
        </div>
      </Confront>
      <p class="body-copy">
        <strong>Evidence:</strong> The changelog on libraries made changes
        visible, but designers wouldn't necessarily consult it as they pulled
        components straight from the assets panel and never saw it in other
        files.
      </p>
      <p class="body-copy">
        <strong>Pivot:</strong> Version info is now written automatically
        into the component's description, so it's visible to everyone. A
        warning icon on component's titles help designers notice an evolution
        at a glance.
      </p>
    </div>

    <Spacer size="md" />

    <div class="pivot-block">
      <h3 class="type-h2" style="color: var(--color-text-heading);">
        03/ Create a reliable source of truth
      </h3>
      <Confront
        tabs={[
          { label: "AFTER", value: "after" },
          { label: "BEFORE", value: "before" },
        ]}
      >
        <div
          data-panel="after"
          class="pivot-panel"
          style="background-image: url('/playground/placeholder.svg');"
        >
        </div>
        <div
          data-panel="before"
          class="pivot-panel"
          style="background-image: url('/playground/placeholder.svg');"
        >
        </div>
      </Confront>
      <p class="body-copy">
        <strong>Initial approach:</strong> All component changes were stored
        in Figma before being sent to Slack for review.
      </p>
      <p class="body-copy">
        <strong>Evidence:</strong> Storing the data directly in Figma made it
        easy to overwrite changes when multiple designers edited the same
        file, risking data loss and duplicated entries. It was also difficult
        to track which changes had already been shared on Slack.
      </p>
      <p class="body-copy">
        <strong>Pivot:</strong> I synced the changes to a GitHub repository,
        giving us a more reliable and structured way to store the data and
        making it usable by AI. To help designers understand what was still
        waiting to be shared, I introduced a Sync Queue: basically a cart
        where pending changes wait for the next sync.
      </p>
    </div>

    <Spacer size="lg" />

    <!-- SOLUTION -->
    <section class="section">
      <SectionHeader
        id="solution"
        eyebrow="Solution"
        title="Making information easy to access, and where designers work"
      />
