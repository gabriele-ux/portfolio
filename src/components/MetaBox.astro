---
interface Props {
  variant?: "default" | "hmw" | "data" | "decision" | "insight";
  class?: string;
}

const { variant = "default", class: className = "" } = Astro.props;

const decorationSrc: Record<string, string | undefined> = {
  hmw: "/decorations/metabox-hmw.svg",
  decision: "/decorations/metabox-decision.svg",
};

const decoration = decorationSrc[variant];
---

<div class:list={["meta-box", `is-${variant}`, className]}>
  {
    decoration && (
      <img
        class="meta-decoration"
        src={decoration}
        alt=""
        aria-hidden="true"
      />
    )
  }
  <slot />
</div>

<style>
  @property --metabox-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .meta-box {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--spacing-gap-2xl);
    column-gap: var(--spacing-gap-2xl);
    padding: var(--spacing-padding-xl);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: 16px;
    overflow: hidden;
    isolation: isolate;
  }

  .meta-box > :not(.meta-decoration) {
    position: relative;
    z-index: 1;
  }

  .meta-decoration {
    position: absolute;
    top: -16px;
    right: -119px;
    width: 170px;
    height: 173px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  @media (min-width: 768px) {
    .meta-box.is-default {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* HMW / Decision — pale blue background, animated border */
  .meta-box.is-hmw,
  .meta-box.is-decision {
    background-color: var(--color-illustration-blue-50);
    border: 0;
    padding: calc(var(--spacing-padding-xl) + 1px);
    --accent: var(--color-accent-info);
    --ring-faint: var(--color-border-faint);
  }

  /* Static faint border replacement (sits exactly on the outer edge) */
  .meta-box.is-hmw::before,
  .meta-box.is-decision::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: var(--ring-faint);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
    z-index: 2;
  }

  /* Rotating bright dot with glow */
  .meta-box.is-hmw::after,
  .meta-box.is-decision::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(
      from var(--metabox-angle),
      transparent 0deg,
      transparent 300deg,
      var(--accent) 340deg,
      #ffffff 358deg,
      #ffffff 362deg,
      var(--accent) 380deg,
      transparent 420deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    filter: drop-shadow(0 0 6px var(--accent));
    animation: metabox-spin 5s linear infinite;
    pointer-events: none;
    z-index: 3;
  }

  @keyframes metabox-spin {
    to {
      --metabox-angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meta-box.is-hmw::after,
    .meta-box.is-decision::after {
      animation: none;
    }
  }

  /* HMW — italic caslon value */
  .meta-box.is-hmw :global(.meta-value) {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--font-weight-medium);
    font-size: var(--text-callout);
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
  }

  /* Insight — dark background, light text */
  .meta-box.is-insight {
    background-color: var(--color-neutral-800);
    border-color: var(--color-neutral-800);
  }
  .meta-box.is-insight :global(.meta-label) {
    color: var(--color-text-on-inverse);
    opacity: 0.65;
  }
  .meta-box.is-insight :global(.meta-value) {
    color: var(--color-text-on-inverse);
  }
</style>
