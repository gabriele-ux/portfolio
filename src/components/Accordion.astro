---
interface Item {
  label: string;
  value: string;
  chosen?: boolean;
}

interface Props {
  items: Item[];
  ariaLabel?: string;
  singleOpen?: boolean;
  class?: string;
}

const {
  items,
  ariaLabel = "Options",
  singleOpen = true,
  class: className = "",
} = Astro.props;

const chosenIdx = items.findIndex((i) => i.chosen);
const defaultIndex = chosenIdx >= 0 ? chosenIdx : 0;
---

<div
  class:list={["accordion", className]}
  data-single-open={singleOpen ? "" : null}
  aria-label={ariaLabel}
>
  {
    items.map((item, i) => {
      const open = i === defaultIndex;
      const headerId = `acc-h-${item.value}`;
      const panelId = `acc-p-${item.value}`;
      return (
        <article class:list={["acc-item", { "is-open": open }]}>
          <button
            type="button"
            class="acc-header"
            aria-expanded={open ? "true" : "false"}
            aria-controls={panelId}
            id={headerId}
          >
            <span class="acc-title">
              <span class="type-label">{item.label}</span>
              <span
                class:list={[
                  "acc-badge",
                  { "acc-badge-muted": !item.chosen },
                ]}
              >
                {item.chosen ? "CHOSEN" : "DISCARDED"}
              </span>
            </span>
            <svg
              class="acc-chevron"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
          <div
            class="acc-panel"
            id={panelId}
            role="region"
            aria-labelledby={headerId}
          >
            <div class="acc-panel-inner">
              <div class="acc-panel-body">
                <slot name={item.value} />
              </div>
            </div>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  .accordion {
    display: flex;
    flex-direction: column;
    background-color: var(--color-neutral-0);
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .acc-item + .acc-item {
    border-top: 1px solid var(--color-border-faint);
  }

  .acc-header {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    cursor: pointer;
    color: var(--color-text-on-inverse);
    background-color: #3d3d3d;
    transition:
      color 200ms ease,
      background-color 200ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .acc-item.is-open .acc-header {
    color: var(--color-text-heading);
    background-color: transparent;
  }

  .acc-header:hover {
    background-color: #2b2b2b;
  }

  .acc-item.is-open .acc-header:hover {
    background-color: var(--color-neutral-50);
  }

  .acc-header:focus-visible {
    outline: 2px solid var(--color-accent-info);
    outline-offset: -2px;
  }

  .acc-item.is-open .acc-header {
    color: var(--color-text-heading);
  }

  .acc-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .acc-badge {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    border-radius: 999px;
    background-color: var(--color-neutral-0);
    color: var(--color-neutral-800);
    border: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .acc-badge-muted {
    background-color: var(--color-neutral-500);
    color: var(--color-text-on-inverse);
    border: none;
  }

  .acc-item.is-open .acc-badge {
    background-color: var(--color-neutral-800);
    color: var(--color-text-on-inverse);
  }

  .acc-item.is-open .acc-badge-muted {
    background-color: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-faint);
  }

  .acc-chevron {
    flex-shrink: 0;
    transition: transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .acc-item.is-open .acc-chevron {
    transform: rotate(180deg);
  }

  .acc-panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .acc-item.is-open .acc-panel {
    grid-template-rows: 1fr;
  }

  .acc-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .acc-panel-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-lg);
    padding: 12px 20px 20px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".accordion").forEach((accordion) => {
    const singleOpen = accordion.hasAttribute("data-single-open");
    const items = Array.from(
      accordion.querySelectorAll<HTMLElement>(":scope > .acc-item")
    );

    items.forEach((item) => {
      const header = item.querySelector<HTMLButtonElement>(".acc-header");
      if (!header) return;

      header.addEventListener("click", () => {
        const isOpen = item.classList.contains("is-open");

        if (singleOpen) {
          items.forEach((other) => {
            if (other !== item) {
              other.classList.remove("is-open");
              other
                .querySelector(".acc-header")
                ?.setAttribute("aria-expanded", "false");
            }
          });
        }

        item.classList.toggle("is-open", !isOpen);
        header.setAttribute("aria-expanded", String(!isOpen));
      });
    });
  });
</script>
