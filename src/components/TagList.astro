---
import Tag from "./Tag.astro";

interface TagData {
  label: string;
  dot?: "success";
}

interface Props {
  tags: TagData[];
  class?: string;
}

const { tags, class: className = "" } = Astro.props;
---

<div class:list={["tag-list", className]}>
  {tags.map((t) => <Tag label={t.label} dot={t.dot} />)}
</div>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-gap-sm);
  }
</style>
