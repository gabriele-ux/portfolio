---
import TagList from "./TagList.astro";

interface TagData {
  label: string;
  dot?: "success";
}

interface Props {
  href: string;
  title: string;
  heroImage?: string;
  heroImageAlt?: string;
  secondaryImage?: string;
  secondaryImageAlt?: string;
  secondaryVideo?: string;
  secondaryVideoPoster?: string;
  tags?: TagData[];
  cta?: string;
  class?: string;
}

const {
  href,
  title,
  heroImage,
  heroImageAlt = "",
  secondaryImage,
  secondaryImageAlt = "",
  secondaryVideo,
  secondaryVideoPoster,
  tags = [],
  cta = "View design process",
  class: className = "",
} = Astro.props;
---

<a href={href} class:list={["project-card", className]}>
  <div class="project-card-media-row">
    <div class="project-card-media project-card-media--primary" data-tilt>
      {
        heroImage ? (
          <img
            class="project-card-image"
            src={heroImage}
            alt={heroImageAlt}
            loading="lazy"
          />
        ) : (
          <div class="project-card-placeholder" aria-hidden="true" />
        )
      }
    </div>
    <div class="project-card-media-stack">
      <div class="project-card-media" data-tilt>
        {
          secondaryVideo ? (
            <video
              class="project-card-image"
              src={secondaryVideo}
              poster={secondaryVideoPoster}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-hidden="true"
            />
          ) : (
            <div class="project-card-placeholder" aria-hidden="true" />
          )
        }
      </div>
      <div class="project-card-media" data-tilt>
        {
          secondaryImage ? (
            <img
              class="project-card-image"
              src={secondaryImage}
              alt={secondaryImageAlt}
              loading="lazy"
            />
          ) : (
            <div class="project-card-placeholder" aria-hidden="true" />
          )
        }
      </div>
    </div>
  </div>

  <div class="project-card-footer">
    <div class="project-card-info">
      <h3 class="project-card-title" set:html={title} />
      {tags.length > 0 && <TagList tags={tags} size="sm" />}
    </div>

    <span class="project-card-cta">
      <span class="cta-label">{cta}</span>
      <svg
        class="cta-arrow"
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </span>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-2xl);
    text-decoration: none;
    color: inherit;
  }

  /* ── Media row: primary 65% + secondary 35% ───────────────── */
  .project-card-media-row {
    display: flex;
    gap: 12px;
    width: 100%;
    aspect-ratio: 5 / 2;
    perspective: 1200px;
  }

  .project-card-media {
    position: relative;
    height: 100%;
    background-color: var(--color-neutral-0);
    border-radius: 16px;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
    overflow: hidden;
    transform-style: preserve-3d;
    transform-origin: center;
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 400ms ease;
    will-change: transform;
  }

  .project-card-media--primary {
    flex: 0 0 calc(65% - 6px);
  }

  .project-card-media-stack {
    flex: 0 0 calc(35% - 6px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
  }

  .project-card-media-stack .project-card-media {
    flex: 1 1 0;
    min-height: 0;
  }

  .project-card-media:hover {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
  }

  .project-card-media.is-tilting {
    transition:
      transform 120ms linear,
      box-shadow 400ms ease;
  }

  @media (hover: none) {
    .project-card-media {
      transform: none !important;
    }
    .project-card-media:hover {
      box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card-media,
    .project-card-media.is-tilting {
      transition: none;
      transform: none !important;
    }
  }

  .project-card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-page);
    background-image: radial-gradient(
      circle,
      var(--color-border-default) 1px,
      transparent 1px
    );
    background-size: 20px 20px;
  }

  /* ── Footer: title/meta + CTA ─────────────────────────────── */
  .project-card-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-gap-lg);
    padding: 0 var(--spacing-padding-md);
  }

  .project-card-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-md);
    min-width: 0;
    flex: 1;
  }

  .project-card-title {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-medium);
    font-size: clamp(1.5rem, calc(1.2rem + 1.5vw), 2.25rem);
    line-height: 1.18;
    letter-spacing: -0.005em;
    color: var(--color-text-heading);
    margin: 0;
  }

  /* ── CTA pill (bordered black, per Figma) ─────────────────── */
  .project-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 50px;
    padding: 0 24px;
    border: 1px solid var(--color-neutral-800);
    border-radius: 999px;
    background-color: transparent;
    color: var(--color-neutral-800);
    font-family: var(--font-serif);
    font-weight: var(--font-weight-normal);
    font-size: 1.25rem;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .project-card:hover .project-card-cta {
    background-color: var(--color-neutral-800);
    color: var(--color-text-on-inverse);
  }

  .cta-arrow {
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .project-card:hover .cta-arrow {
    transform: translate(1px, -1px);
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 654px) {
    .project-card-media-row {
      flex-direction: column;
      aspect-ratio: auto;
    }
    .project-card-media--primary,
    .project-card-media-stack {
      flex: 1 1 auto;
    }
    .project-card-media--primary,
    .project-card-media-stack .project-card-media {
      aspect-ratio: 4 / 3;
    }
    .project-card-media-stack .project-card-media {
      flex: 1 1 auto;
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .project-card-footer {
      flex-direction: column;
      align-items: stretch;
      gap: var(--spacing-gap-lg);
      padding: 0;
    }
    .project-card-info {
      width: 100%;
    }
    .project-card-cta {
      align-self: stretch;
      justify-content: center;
    }
  }
</style>

<script>
  const MAX_TILT = 12;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  const isTouch = window.matchMedia("(hover: none)").matches;

  if (!reduceMotion && !isTouch) {
    const tiles = document.querySelectorAll<HTMLElement>("[data-tilt]");
    tiles.forEach((tile) => {
      let rafId = 0;

      const onMove = (e: PointerEvent) => {
        const rect = tile.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          const rotY = px * MAX_TILT;
          const rotX = -py * MAX_TILT;
          tile.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
        });
      };

      const onEnter = () => {
        tile.classList.add("is-tilting");
      };

      const onLeave = () => {
        if (rafId) cancelAnimationFrame(rafId);
        tile.classList.remove("is-tilting");
        tile.style.transform = "";
      };

      tile.addEventListener("pointerenter", onEnter);
      tile.addEventListener("pointermove", onMove, { passive: true });
      tile.addEventListener("pointerleave", onLeave);
      tile.addEventListener("pointercancel", onLeave);
    });
  }
</script>
