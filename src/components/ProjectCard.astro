---
import TagList from "./TagList.astro";

interface TagData {
  label: string;
  dot?: "success";
}

interface Props {
  href: string;
  title: string;
  heroImage?: string;
  heroImageAlt?: string;
  tags?: TagData[];
  class?: string;
}

const {
  href,
  title,
  heroImage,
  heroImageAlt = "",
  tags = [],
  class: className = "",
} = Astro.props;

---

<a href={href} class:list={["project-card", className]}>
  <div class="project-card-media">
    {
      heroImage ? (
        <img
          class="project-card-image"
          src={heroImage}
          alt={heroImageAlt}
          loading="lazy"
        />
      ) : (
        <div class="project-card-placeholder" aria-hidden="true" />
      )
    }
    <span class="project-card-badge" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        fill="currentColor"
        viewBox="0 0 256 256"
      >
        <path
          d="M128,112a28,28,0,0,0-8,54.83V184a8,8,0,0,0,16,0V166.83A28,28,0,0,0,128,112Zm0,40a12,12,0,1,1,12-12A12,12,0,0,1,128,152Zm80-72H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96ZM208,208H48V96H208V208Z"
        ></path>
      </svg>
    </span>
  </div>

  <div class="project-card-footer">
    {tags.length > 0 && <TagList tags={tags} size="sm" />}
    <h3 class="project-card-title" set:html={title} />
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-neutral-0);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
    transition:
      box-shadow 300ms ease,
      transform 300ms ease;
  }

  .project-card:hover {
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card:hover {
      transition: none;
      transform: none;
    }
  }

  /* ── Media ─────────────────────────────────────────────────── */
  .project-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-page);
  }

  .project-card-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-neutral-0);
    color: var(--color-neutral-800);
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .project-card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-page);
    background-image: radial-gradient(
      circle,
      var(--color-border-default) 1px,
      transparent 1px
    );
    background-size: 20px 20px;
  }

  /* ── Footer ────────────────────────────────────────────────── */
  .project-card-footer {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-lg);
    padding: clamp(20px, 2.5vw, 32px);
  }

  .project-card-title {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-medium);
    font-size: clamp(1.25rem, calc(1rem + 0.9vw), 1.75rem);
    line-height: 1.18;
    letter-spacing: -0.005em;
    color: var(--color-text-heading);
    margin: 0;
    text-wrap: balance;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 600px) {
    .project-card-media {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  const MAX_TILT = 12;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  const isTouch = window.matchMedia("(hover: none)").matches;

  if (!reduceMotion && !isTouch) {
    const tiles = document.querySelectorAll<HTMLElement>("[data-tilt]");
    tiles.forEach((tile) => {
      let rafId = 0;

      const onMove = (e: PointerEvent) => {
        const rect = tile.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          const rotY = px * MAX_TILT;
          const rotX = -py * MAX_TILT;
          tile.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
        });
      };

      const onEnter = () => {
        tile.classList.add("is-tilting");
      };

      const onLeave = () => {
        if (rafId) cancelAnimationFrame(rafId);
        tile.classList.remove("is-tilting");
        tile.style.transform = "";
      };

      tile.addEventListener("pointerenter", onEnter);
      tile.addEventListener("pointermove", onMove, { passive: true });
      tile.addEventListener("pointerleave", onLeave);
      tile.addEventListener("pointercancel", onLeave);
    });
  }
</script>
