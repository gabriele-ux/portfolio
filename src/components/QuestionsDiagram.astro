---
/*
 * QuestionsDiagram — decorative diagram with a topographic background image
 * and 3 pill-shaped questions overlaid as real HTML text (Doto Black),
 * so they stay legible at any viewport size.
 */

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const questions = [
  "“Is this component up to date?”",
  "“Has this component changed? Why?”",
  "“Which version should I use?”",
];
---

<div class:list={["questions-diagram-wrap", className]}>
  <div class="questions-diagram" role="img" aria-label="Recurring questions from designers: is this component up to date? Has this component changed? Why? Which version should I use?">
    <span class="question-pill question-pill--1" aria-hidden="true">{questions[0]}</span>
    <span class="question-pill question-pill--2" aria-hidden="true">{questions[1]}</span>
    <span class="question-pill question-pill--3" aria-hidden="true">{questions[2]}</span>
  </div>
</div>

<style>
  .questions-diagram-wrap {
    container-type: inline-size;
    width: 100%;
  }

  .questions-diagram {
    position: relative;
    width: 100%;
    aspect-ratio: 3040 / 1448;
    min-height: 280px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background-color: var(--color-neutral-800);
    background-image: url("/case-studies/design-system-search/diagram-questions-bg.jpg");
    background-size: cover;
    background-position: center;
    border-radius: 16px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .question-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 64px;
    padding: 0 24px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-neutral-0);
    font-family: "Doto", var(--font-mono);
    font-weight: 900;
    font-variation-settings: "ROND" 0, "wght" 900;
    font-size: clamp(0.7rem, 2.4cqi, 1.25rem);
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-sizing: border-box;
    max-width: 100%;
  }

  .question-pill--1 {
    position: relative;
    left: -20%;
  }

  .question-pill--2 {
    background-color: rgba(0, 0, 0, 0.1);
  }

  .question-pill--3 {
    position: relative;
    left: 20%;
  }

  @container (max-width: 560px) {
    .question-pill {
      width: 100%;
      min-height: 64px;
      height: auto;
      white-space: normal;
      text-align: center;
      padding: 12px 16px;
      font-size: var(--text-body);
      line-height: var(--leading-relaxed);
    }

    .question-pill--1,
    .question-pill--3 {
      left: 0;
    }
  }
</style>
