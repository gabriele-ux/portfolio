---
// Rough prototype of the first (failed) approach: an automatic detection
// script listing every change caught on Figma nodes, ordered by date.
// It surfaces meaningful component edits mixed with noise (auto-named
// frames/rectangles) — this is the very problem the pivot solves.
// Intentionally rudimentary — "before" state of pivot 01.
---

<div class="p1m" role="img" aria-label="Rudimentary mock of the automatic change detector prototype">
  <div class="p1m-card">
    <div class="p1m-header">
      <span class="p1m-app">Change detector</span>
      <span class="p1m-badge">v0.1</span>
    </div>

    <ol class="p1m-list">
      <li class="p1m-group">
        <div class="p1m-date">Today, Sep 9</div>
        <ul class="p1m-rows">
          <li class="p1m-row">
            <span class="p1m-thumb p1m-thumb-fill" aria-hidden="true"></span>
            <div class="p1m-info">
              <span class="p1m-node">Card / Dashboard</span>
              <span class="p1m-hint">
                <code>fills[0].color</code> changed on <code>node 123:456</code>
              </span>
            </div>
            <a class="p1m-cta" href="#" onclick="return false;">
              Add changelog details
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M3.5 3h3.5v3.5M7 3L3 7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>

          <li class="p1m-row">
            <span class="p1m-thumb p1m-thumb-layout" aria-hidden="true"></span>
            <div class="p1m-info">
              <span class="p1m-node">Button / Primary</span>
              <span class="p1m-hint">
                <code>autoLayout.padding</code> changed on <code>node 341:892</code>
              </span>
            </div>
            <a class="p1m-cta" href="#" onclick="return false;">
              Add changelog details
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M3.5 3h3.5v3.5M7 3L3 7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>

          <li class="p1m-row p1m-row-noise">
            <span class="p1m-thumb p1m-thumb-generic" aria-hidden="true"></span>
            <div class="p1m-info">
              <span class="p1m-node">Frame 340343</span>
              <span class="p1m-hint">
                <code>x, y</code> changed on <code>node 552:104</code>
              </span>
            </div>
            <a class="p1m-cta" href="#" onclick="return false;">
              Add changelog details
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M3.5 3h3.5v3.5M7 3L3 7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>

          <li class="p1m-row p1m-row-noise">
            <span class="p1m-thumb p1m-thumb-generic" aria-hidden="true"></span>
            <div class="p1m-info">
              <span class="p1m-node">Rectangle 12</span>
              <span class="p1m-hint">
                <code>width</code> changed on <code>node 118:721</code>
              </span>
            </div>
            <a class="p1m-cta" href="#" onclick="return false;">
              Add changelog details
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M3.5 3h3.5v3.5M7 3L3 7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        </ul>
      </li>

      <li class="p1m-group">
        <div class="p1m-date">Yesterday, Sep 8</div>
        <ul class="p1m-rows">
          <li class="p1m-row">
            <span class="p1m-thumb p1m-thumb-variant" aria-hidden="true"></span>
            <div class="p1m-info">
              <span class="p1m-node">Card / Dashboard</span>
              <span class="p1m-hint">
                <code>variant "state=hover"</code> added on <code>node 123:456</code>
              </span>
            </div>
            <a class="p1m-cta" href="#" onclick="return false;">
              Add changelog details
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M3.5 3h3.5v3.5M7 3L3 7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>

          <li class="p1m-row p1m-row-noise">
            <span class="p1m-thumb p1m-thumb-generic" aria-hidden="true"></span>
            <div class="p1m-info">
              <span class="p1m-node">Group 5 / Ellipse 3</span>
              <span class="p1m-hint">
                <code>cornerRadius</code> changed on <code>node 674:293</code>
              </span>
            </div>
            <a class="p1m-cta" href="#" onclick="return false;">
              Add changelog details
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M3.5 3h3.5v3.5M7 3L3 7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        </ul>
      </li>
    </ol>
  </div>
</div>

<style>
  .p1m {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: #f3f5f6;
    box-sizing: border-box;
  }

  .p1m-card {
    background: #ffffff;
    border: 1px solid #d3d3d6;
    border-radius: 6px;
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 13px;
    line-height: 1.4;
    color: #1e1a15;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .p1m-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid #e8e9eb;
    background: #fafafa;
  }
  .p1m-app {
    font-weight: 600;
    font-size: 13px;
  }
  .p1m-badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    color: #808187;
    background: #f3f3f4;
    padding: 2px 7px;
    border-radius: 3px;
  }

  .p1m-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .p1m-group {
    display: flex;
    flex-direction: column;
  }
  .p1m-date {
    padding: 8px 16px 4px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #808187;
    background: #fafafa;
    border-bottom: 1px solid #f3f3f4;
  }
  .p1m-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .p1m-row {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid #f3f3f4;
  }
  .p1m-row:last-child {
    border-bottom: none;
  }
  .p1m-row-noise .p1m-node {
    color: #808187;
    font-weight: 400;
  }

  /* ── Node preview thumb ── */
  .p1m-thumb {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    border: 1px solid #d3d3d6;
    background: #fafafa;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }
  .p1m-thumb-fill {
    background: linear-gradient(135deg, #ffffff 0%, #ffffff 49%, #d3d3d6 49%, #d3d3d6 51%, #f3f5f6 51%, #f3f5f6 100%);
  }
  .p1m-thumb-layout {
    background: #ffffff;
    background-image:
      linear-gradient(to right, #d3d3d6 1px, transparent 1px),
      linear-gradient(to bottom, #d3d3d6 1px, transparent 1px);
    background-size: 8px 8px;
    background-position: 4px 4px;
  }
  .p1m-thumb-variant::before,
  .p1m-thumb-variant::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid #808187;
    background: #ffffff;
    border-radius: 2px;
  }
  .p1m-thumb-variant::before {
    top: 6px;
    left: 6px;
  }
  .p1m-thumb-variant::after {
    bottom: 6px;
    right: 6px;
    border-color: #0066cc;
  }
  .p1m-thumb-generic {
    background: repeating-linear-gradient(
      45deg,
      #f3f3f4,
      #f3f3f4 3px,
      #e8e9eb 3px,
      #e8e9eb 6px
    );
  }

  /* ── Row info ── */
  .p1m-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .p1m-node {
    font-size: 12px;
    font-weight: 500;
    color: #1e1a15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .p1m-hint {
    font-size: 11px;
    color: #808187;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .p1m-hint code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    background: #f3f3f4;
    padding: 1px 4px;
    border-radius: 2px;
    color: #525460;
  }

  /* ── CTA link ── */
  .p1m-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: #0066cc;
    text-decoration: none;
    white-space: nowrap;
  }
  .p1m-cta:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .p1m-card {
      max-width: 380px;
    }
    .p1m-row {
      grid-template-columns: 28px minmax(0, 1fr) auto;
      gap: 8px;
      padding: 8px 12px;
    }
    .p1m-thumb {
      width: 28px;
      height: 28px;
    }
    .p1m-cta {
      font-size: 10px;
    }
    .p1m-hint code {
      font-size: 9px;
    }
  }
</style>
