---
interface Props {
  eyebrow?: string;
  title: string;
  size?: "default" | "large";
  class?: string;
}

const {
  eyebrow,
  title,
  size = "default",
  class: className = "",
} = Astro.props;
---

<header class:list={["section-header", className]}>
  {eyebrow && <p class="type-eyebrow section-eyebrow">{eyebrow}</p>}
  <h2
    class:list={[
      "section-title",
      size === "large" ? "type-display" : "type-h1",
    ]}
  >
    {title}
  </h2>
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-md);
  }

  .section-eyebrow {
    color: var(--color-text-eyebrow);
    text-transform: uppercase;
    margin: 0;
  }

  .section-title {
    color: var(--color-text-heading);
    margin: 0;
  }
</style>
