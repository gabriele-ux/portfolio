---
/*
 * Header — top bar.
 * Figma: 160:2109
 * Struttura:
 *   Left  → logo (24px) + brand "Gabriele La Rosa" (DM Sans 16, gap 12)
 *   Right → orange Button (Button.astro) "Let's talk"
 * Padding 24px orizzontale · 10px verticale · sticky top · glass on scroll.
 */
import Button from "./Button.astro";

interface Props {
  brand?: string;
  homeHref?: string;
  ctaLabel?: string;
  ctaEmail?: string;
  class?: string;
}

const {
  brand = "Gabriele La Rosa",
  homeHref = "/",
  ctaLabel = "Let's talk",
  ctaEmail = "gabrielelarosa013@gmail.com",
  class: className = "",
} = Astro.props;
---

<header
  class:list={["topbar", className]}
  data-scrolled="false"
  aria-label="Site header"
>
  <a href={homeHref} class="topbar-brand" aria-label={brand}>
    <span class="topbar-icon" aria-hidden="true">
      <svg
        width="28"
        height="32"
        viewBox="0 0 28 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g clip-path="url(#tb-logo-clip)">
          <rect width="27.206" height="32" rx="3.77861" fill="#3A3A3A"></rect>
          <path
            d="M13.6376 7.55722L10.9014 10.9015L13.6376 13.4097L16.6019 10.9015L13.6376 7.55722Z"
            fill="white"></path>
          <path
            d="M14.2457 20.8583H13.0296L13.1056 22.6825C13.5312 23.2297 14.043 22.9612 14.2457 22.7585V20.8583Z"
            fill="white"></path>
          <path
            d="M8.16518 22.0745C8.91258 21.7451 10.7342 21.284 12.0415 22.0745C13.3488 22.8649 13.1943 23.7213 12.9536 24.0506C12.5229 24.304 11.3727 24.6587 10.2174 24.0506C9.06206 23.4426 8.36786 22.4798 8.16518 22.0745Z"
            fill="white"></path>
          <path
            d="M19.0443 22.1309C18.2969 21.8015 16.4753 21.3404 15.168 22.1309C13.8607 22.9213 14.0152 23.7777 14.2559 24.107C14.6866 24.3604 15.8369 24.7151 16.9922 24.107C18.1475 23.499 18.8417 22.5362 19.0443 22.1309Z"
            fill="white"></path>
          <path
            d="M19.6487 15.6139V8.62131C18.1285 8.86453 15.3163 11.2055 14.1002 12.3456C11.4984 15.2597 11.9151 19.1027 13.0296 20.8583C13.2174 21.1542 13.9175 20.7261 14.1002 20.9343C18.1133 20.7519 19.4713 17.3114 19.6487 15.6139Z"
            fill="white"></path>
          <path
            d="M7.55713 15.6139V8.62131C9.07726 8.86453 11.8895 11.2055 13.1056 12.3456C16.1459 15.7507 14.3724 19.4902 13.1056 20.9343C9.09246 20.7519 7.73448 17.3114 7.55713 15.6139Z"
            fill="white"></path>
        </g>
        <defs>
          <clipPath id="tb-logo-clip">
            <rect width="27.206" height="32" rx="3.77861" fill="white"></rect>
          </clipPath>
        </defs>
      </svg>
    </span>
    <span class="topbar-name">{brand}</span>
  </a>

  <Button class="topbar-cta" data-copy-email={ctaEmail}>{ctaLabel}</Button>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 24px;
    background-color: rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid transparent;
    transition:
      background-color 240ms ease,
      -webkit-backdrop-filter 240ms ease,
      backdrop-filter 240ms ease,
      border-bottom-color 240ms ease;
    box-sizing: border-box;
  }

  .topbar[data-scrolled="true"] {
    background-color: var(--color-alpha-white-85);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    backdrop-filter: blur(20px) saturate(140%);
    border-bottom-color: var(--color-border-faint);
  }

  /* ── Left: icon + brand ────────────────────────────────────── */
  .topbar-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-text-heading);
    transition: color 150ms ease;
  }

  .topbar-icon {
    display: inline-flex;
    width: 28px;
    height: 32px;
    flex-shrink: 0;
  }

  .topbar-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .topbar-name {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-normal);
    font-size: 16px;
    line-height: 1;
    white-space: nowrap;
    font-variation-settings: "opsz" 14;
    color: var(--color-text-heading);
  }

  /* ── CTA — reuses Button.astro, override height per Figma (44px) ── */
  .topbar :global(.topbar-cta) {
    height: 44px;
    padding: 0 var(--spacing-padding-md);
  }

  @media (max-width: 480px) {
    .topbar-name {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar {
      transition: none;
    }
  }
</style>

<script>
  const topbar = document.querySelector<HTMLElement>(".topbar");
  if (topbar) {
    const updateScrolled = () => {
      topbar.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
    };
    updateScrolled();
    window.addEventListener("scroll", updateScrolled, { passive: true });
  }

  const cta = document.querySelector<HTMLElement>(
    ".topbar-cta[data-copy-email]"
  );
  if (cta) {
    cta.addEventListener("click", async (event) => {
      event.preventDefault();
      const email = cta.dataset.copyEmail;
      if (!email) return;
      const toast = (
        window as unknown as { showToast?: (msg: string) => void }
      ).showToast;
      try {
        await navigator.clipboard.writeText(email);
        toast?.(`Email copied — ${email}`);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>
