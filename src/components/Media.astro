---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  type?: "image" | "video";
  aspect?: string;
  class?: string;
}

const {
  src,
  alt = "",
  caption,
  type,
  aspect = "1920 / 1080",
  class: className = "",
} = Astro.props;

const isVideo =
  type === "video" ||
  (!type && /\.(mp4|webm|mov|ogg|ogv|m4v)$/i.test(src));
---

<figure class:list={["media", className]}>
  <div class="media-content" style={`aspect-ratio: ${aspect};`}>
    {
      isVideo ? (
        <video
          src={src}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={alt || undefined}
        />
      ) : (
        <button
          type="button"
          class="media-trigger"
          aria-label={alt ? `Open full-screen: ${alt}` : "Open image full-screen"}
        >
          <img src={src} alt={alt} loading="lazy" />
          <span class="media-zoom-badge" aria-hidden="true">
            <svg
              width="14"
              height="14"
              viewBox="0 0 256 256"
              fill="currentColor"
            >
              <path
                d="M152,112a8,8,0,0,1-8,8H120v24a8,8,0,0,1-16,0V120H80a8,8,0,0,1,0-16h24V80a8,8,0,0,1,16,0v24h24A8,8,0,0,1,152,112Zm77.66,117.66a8,8,0,0,1-11.32,0l-50.06-50.07a88.11,88.11,0,1,1,11.31-11.31l50.07,50.06A8,8,0,0,1,229.66,229.66ZM112,184a72,72,0,1,0-72-72A72.08,72.08,0,0,0,112,184Z"
              />
            </svg>
          </span>
        </button>
      )
    }
  </div>

  {
    caption && (
      <figcaption class="type-caption media-caption">
        <svg
          class="media-caption-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="12" y1="19" x2="12" y2="5" />
          <polyline points="5 12 12 5 19 12" />
        </svg>
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>

{
  !isVideo && (
    <dialog class="media-lightbox" aria-label="Full-screen image">
      <img src={src} alt={alt} class="media-lightbox-img" />
      <button
        type="button"
        class="media-lightbox-close"
        aria-label="Close full-screen"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M4 4L14 14M14 4L4 14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </dialog>
  )
}

<style>
  .media {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-sm);
    margin: 0;
  }

  .media-content {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-card-border);
    border-radius: 8px;
    background-color: var(--color-bg-elevated);
  }

  .media-content > img,
  .media-content > video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-trigger {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    margin: 0;
    background: none;
    cursor: zoom-in;
  }
  .media-trigger img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-zoom-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 1px solid #fff;
    background: rgba(255, 255, 255, 0.5);
    color: #000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    backdrop-filter: blur(2px);
  }

  .media-caption {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-gap-xs);
    color: var(--color-text-muted);
  }

  .media-caption-arrow {
    flex-shrink: 0;
  }

  /* ── Lightbox ──────────────────────────────────────────────── */
  .media-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }
  .media-lightbox::backdrop {
    background: rgba(30, 26, 21, 0.85);
    backdrop-filter: blur(4px);
  }
  .media-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .media-lightbox-img {
    display: block;
    max-width: min(90vw, 1600px);
    max-height: 85vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    cursor: default;
  }
  .media-lightbox-close {
    position: fixed;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: none;
    background: var(--color-neutral-800);
    color: #fff;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease;
  }
  .media-lightbox-close:hover {
    background: #000;
  }
</style>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>(".media-trigger");

  triggers.forEach((trigger) => {
    const figure = trigger.closest("figure.media");
    const dialog = figure?.nextElementSibling as HTMLDialogElement | null;
    if (!dialog || dialog.tagName !== "DIALOG") return;

    const closeBtn = dialog.querySelector<HTMLButtonElement>(
      ".media-lightbox-close"
    );

    const open = () => {
      if (typeof dialog.showModal === "function") dialog.showModal();
      else dialog.setAttribute("open", "");
    };
    const close = () => {
      if (typeof dialog.close === "function") dialog.close();
      else dialog.removeAttribute("open");
    };

    trigger.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);

    // Click outside the image (on backdrop) closes.
    dialog.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const isImg = target.classList.contains("media-lightbox-img");
      const isClose = !!target.closest(".media-lightbox-close");
      if (!isImg && !isClose) close();
    });
  });
</script>
