---
import MetaBox from "./MetaBox.astro";
import MetaItem from "./MetaItem.astro";
const stages = [
  { label: "01 / Changes", title: "Changes happen across libraries", description: "Components evolve inside product UI Kits and the main Design System libraries. Without a shared record, it is difficult to see what changed across projects.", impact: "Product designers risk using outdated components or duplicating work." },
  { label: "02 / Communication", title: "Updates stay in scattered conversations", description: "Some changes are shared with the Design System team; others only reach the person who requested them. Slack, email and meetings do not give everyone a consistent view.", impact: "Other designers can miss changes that affect their work." },
  { label: "03 / Retrieval", title: "Finding the history means asking around", description: "To understand what changed and why, designers have to search old messages or ask a colleague. The Design System team repeatedly reconstructs the same context.", impact: "Answering recurring questions could take up to a full day." },
];
const paths = [
  { team: "Product Designers", tone: "product", nodes: ["Components evolve in a project or UI Kit", "Shared with the Design System team", "Other designers may miss the change"] },
  { team: "Design System team", tone: "system", nodes: ["Main libraries updated after a request", "Shared with the requester", "Search old messages or ask someone"] },
];
---
<change-workflow>
  <div class="workflow-heading">
    <span class="type-caption">Mapping the existing workflow</span>
    <span class="workflow-hint">Hover or select a step to explore</span>
  </div>
  <div class="workflow-map" role="group" aria-label="How component changes were shared">
    <div class="column-labels" aria-hidden="true"><span>Changes</span><span>Communication</span><span>Retrieval</span></div>
    {paths.map(path => (
      <div class:list={["workflow-path", path.tone]}>
        <p class="team-label">{path.team}</p>
        <div class="path-nodes">
          {path.nodes.map((label, index) => (
            <button type="button" data-stage={index} aria-pressed={index === 1 ? "true" : "false"} aria-controls="workflow-detail">
              <span class="node-number">0{index + 1}</span>
              <span>{label}</span>
              {index < 2 && <span class="connector" aria-hidden="true">→</span>}
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div id="workflow-detail" class="workflow-detail" aria-live="polite" aria-atomic="true">
    {stages.map((stage, index) => (
      <div data-detail={index} hidden={index !== 1}>
        <MetaBox variant="insight">
          <div class="detail-content">
            <MetaItem label={stage.label}>
              <h3 class="type-h5">{stage.title}</h3>
              <p class="type-body">{stage.description}</p>
            </MetaItem>
            <MetaItem label="Consequence" value={stage.impact} />
          </div>
        </MetaBox>
      </div>
    ))}
  </div>
  <div class="workflow-finding">
    <span class="finding-icon" aria-hidden="true">!</span>
    <p><strong>A shared process was missing.</strong> We needed a consistent way to record, communicate and retrieve component changes across teams.</p>
  </div>
  <noscript><p>Changes were distributed across libraries, updates could miss other designers, and finding a component’s history meant searching messages or asking colleagues.</p></noscript>
</change-workflow>

<script>
  class ChangeWorkflow extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      const buttons = this.querySelectorAll<HTMLButtonElement>("button[data-stage]");
      const details = this.querySelectorAll<HTMLElement>("[data-detail]");
      let selected = "1";
      const show = (stage: string) => {
        buttons.forEach(button => button.setAttribute("aria-pressed", String(button.dataset.stage === stage)));
        details.forEach(detail => { detail.hidden = detail.dataset.detail !== stage; });
      };
      buttons.forEach(button => {
        button.addEventListener("pointerenter", event => {
          if (event.pointerType === "mouse") show(button.dataset.stage!);
        });
        button.addEventListener("focus", () => show(button.dataset.stage!));
        button.addEventListener("click", () => { selected = button.dataset.stage!; show(selected); });
      });
      this.querySelector(".workflow-map")?.addEventListener("pointerleave", () => {
        const focused = Array.from(buttons).find(button => button === document.activeElement);
        show(focused?.dataset.stage ?? selected);
      });
      this.addEventListener("focusout", event => {
        if (!this.contains(event.relatedTarget as Node)) show(selected);
      });
    }
  }
  if (!customElements.get("change-workflow")) customElements.define("change-workflow", ChangeWorkflow);
</script>

<style>
  change-workflow { display: block; --workflow-accent: var(--color-orange-500); }
  .workflow-heading { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
  .workflow-hint { font-size: 12px; color: var(--color-text-body-secondary); }
  .workflow-map { padding: 24px; border: 1px solid var(--color-border-faint); border-radius: 16px; background: var(--color-bg-elevated); }
  .column-labels, .path-nodes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .column-labels { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--color-text-body-secondary); margin-bottom: 22px; }
  .workflow-path + .workflow-path { margin-top: 26px; }
  .team-label { font-size: 12px; font-weight: 700; margin: 0 0 10px; color: var(--team-color); }
  .product { --team-color: var(--color-green-700); }
  .system { --team-color: var(--color-blue-600); }
  button { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; width: 100%; min-height: 132px; padding: 16px; border: 1px solid var(--color-border-faint); border-radius: 10px; background: var(--color-bg-page); color: var(--color-text-body); text-align: left; font: inherit; font-size: 14px; line-height: 1.45; cursor: pointer; transition: border-color 160ms, background-color 160ms; }
  button[aria-pressed="true"] { border-color: var(--workflow-accent); background: color-mix(in srgb, var(--workflow-accent) 5%, var(--color-bg-elevated)); }
  button:focus-visible { outline: 2px solid var(--color-text-heading); outline-offset: 4px; }
  .node-number { color: var(--team-color); font-size: 11px; font-weight: 700; }
  .connector { position: absolute; right: -23px; top: 50%; transform: translateY(-50%); color: var(--color-text-muted); font-size: 20px; pointer-events: none; }
  .workflow-detail { margin-top: var(--spacing-gap-md); }
  [hidden] { display: none !important; }
  .detail-content { display: flex; flex-direction: column; gap: var(--spacing-gap-lg); }
  .detail-content h3 { margin: 0 0 var(--spacing-gap-xs); color: var(--color-text-heading); }
  .detail-content p { margin: 0; }
  .workflow-finding p { font-size: var(--text-body-sm); line-height: var(--leading-normal); margin: 0; }
  .workflow-finding { display: flex; align-items: flex-start; gap: 14px; padding: 22px 4px 0; }
  .workflow-finding strong { display: block; }
  .finding-icon { display: grid; place-items: center; flex: 0 0 24px; height: 24px; margin-top: 2px; border-radius: 50%; background: var(--workflow-accent); color: white; font-weight: 700; }
  @media (max-width: 600px) {
    .workflow-map { padding: 18px; }
    .column-labels { display: none; }
    .path-nodes { grid-template-columns: 1fr; gap: 22px; }
    button { min-height: auto; flex-direction: row; align-items: baseline; gap: 14px; padding: 14px; }
    .connector { right: auto; left: 18px; top: auto; bottom: -24px; transform: rotate(90deg); font-size: 18px; }
    .workflow-path + .workflow-path { padding-top: 22px; border-top: 1px solid var(--color-border-faint); }

  }
  @media (prefers-reduced-motion: reduce) { button { transition: none; } }
</style>
