---
import Button from "./Button.astro";

interface Props {
  /** Unique id for sessionStorage key (one per protected page). */
  id: string;
  /** SHA-256 hex of the required password (lowercase). */
  hash: string;
  title?: string;
  description?: string;
}

const {
  id,
  hash,
  title = "Protected case study",
  description = "This case study is under NDA. Enter the password to view the content.",
} = Astro.props;
---

<section
  class="pw-gate"
  data-pw-gate
  data-pw-id={id}
  data-pw-hash={hash}
  aria-labelledby="pw-gate-title"
>
  <div class="pw-gate-inner">
    <span class="pw-gate-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
        <path
          d="M6 10V7a6 6 0 1 1 12 0v3"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        ></path>
        <rect
          x="4"
          y="10"
          width="16"
          height="11"
          rx="2"
          stroke="currentColor"
          stroke-width="1.5"
        ></rect>
        <circle cx="12" cy="15.5" r="1.25" fill="currentColor"></circle>
      </svg>
    </span>

    <h1 id="pw-gate-title" class="pw-gate-title">{title}</h1>
    <p class="pw-gate-desc">{description}</p>

    <form class="pw-gate-form" data-pw-form novalidate>
      <label class="pw-gate-field">
        <span class="pw-gate-label">Password</span>
        <input
          type="password"
          name="password"
          class="pw-gate-input"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          required
          data-pw-input
        />
      </label>

      <p class="pw-gate-error" data-pw-error aria-live="polite"></p>

      <Button type="submit" class="pw-gate-submit">
        <span>Unlock</span>
      </Button>
    </form>

    <p class="pw-gate-help">
      Don't have access? Reach out via the <strong>Let's talk</strong> button in
      the header.
    </p>
  </div>
</section>

<div class="pw-gate-content" data-pw-content hidden>
  <slot />
</div>

<style>
  .pw-gate {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 60px);
    padding: clamp(2rem, 8vw, 5rem) clamp(1.25rem, 6vw, 4rem);
    background: var(--color-bg-page);
    position: relative;
  }

  .pw-gate::before,
  .pw-gate::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border-default);
    pointer-events: none;
  }

  .pw-gate::before {
    left: clamp(0.625rem, 4vw, 5rem);
  }

  .pw-gate::after {
    right: clamp(0.625rem, 4vw, 5rem);
  }

  .pw-gate-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-16);
    width: 100%;
    max-width: 420px;
  }

  .pw-gate-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background-color: var(--color-neutral-800);
    color: var(--color-text-on-inverse);
    margin-bottom: var(--spacing-8);
  }

  .pw-gate-title {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-h1);
    line-height: var(--text-h1--line-height);
    color: var(--color-text-heading);
    margin: 0;
    font-variation-settings: "opsz" 24;
  }

  .pw-gate-desc {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-light);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--color-text-heading);
    margin: 0;
    font-variation-settings: "opsz" 14;
    text-wrap: pretty;
    max-width: 36ch;
  }

  .pw-gate-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
    width: 100%;
    margin-top: var(--spacing-16);
  }

  .pw-gate-field {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-8);
    text-align: left;
  }

  .pw-gate-label {
    font-family: var(--font-mono);
    font-weight: var(--font-weight-normal);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-heading);
  }

  .pw-gate-input {
    width: 100%;
    height: 44px;
    padding: 0 var(--spacing-16);
    border-radius: 10px;
    border: 1px solid var(--color-border-default);
    background: var(--color-neutral-0);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-heading);
    box-sizing: border-box;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .pw-gate-input:focus {
    outline: none;
    border-color: var(--color-neutral-800);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-neutral-800) 15%, transparent);
  }

  .pw-gate[data-pw-state="error"] .pw-gate-input {
    border-color: #d33a3a;
    box-shadow: 0 0 0 3px color-mix(in oklab, #d33a3a 15%, transparent);
  }

  .pw-gate-error {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: #d33a3a;
    margin: 0;
    min-height: 1.4em;
    text-align: left;
  }

  .pw-gate :global(.pw-gate-submit) {
    width: 100%;
    height: 48px;
  }

  .pw-gate-help {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-light);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-text-heading);
    margin: var(--spacing-16) 0 0;
    opacity: 0.75;
  }

  .pw-gate-help strong {
    font-weight: var(--font-weight-medium);
  }
</style>

<script>
  async function sha256Hex(input: string): Promise<string> {
    const bytes = new TextEncoder().encode(input);
    const digest = await crypto.subtle.digest("SHA-256", bytes);
    return Array.from(new Uint8Array(digest))
      .map((b) => b.toString(16).padStart(2, "0"))
      .join("");
  }

  const gates = document.querySelectorAll<HTMLElement>("[data-pw-gate]");

  gates.forEach((gate) => {
    const id = gate.dataset.pwId ?? "default";
    const hash = (gate.dataset.pwHash ?? "").toLowerCase();
    const storageKey = `pw-gate-unlocked:${id}`;
    const content = document.querySelector<HTMLElement>(
      `[data-pw-content]`
    );
    const form = gate.querySelector<HTMLFormElement>("[data-pw-form]");
    const input = gate.querySelector<HTMLInputElement>("[data-pw-input]");
    const errorEl = gate.querySelector<HTMLElement>("[data-pw-error]");

    const unlock = () => {
      gate.remove();
      if (content) content.hidden = false;
    };

    if (sessionStorage.getItem(storageKey) === "1") {
      unlock();
      return;
    }

    input?.focus();

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!input) return;
      const value = input.value;
      const digest = await sha256Hex(value);
      if (digest === hash) {
        sessionStorage.setItem(storageKey, "1");
        if (errorEl) errorEl.textContent = "";
        unlock();
      } else {
        gate.dataset.pwState = "error";
        if (errorEl) errorEl.textContent = "Wrong password — try again.";
        input.select();
      }
    });

    input?.addEventListener("input", () => {
      if (gate.dataset.pwState === "error") {
        gate.dataset.pwState = "";
        if (errorEl) errorEl.textContent = "";
      }
    });
  });
</script>
