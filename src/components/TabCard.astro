---
import TabList from "./TabList.astro";
import TabItem from "./TabItem.astro";

interface Tab {
  label: string;
  value: string;
}

interface Props {
  tabs: Tab[];
  ariaLabel?: string;
  class?: string;
}

const { tabs, ariaLabel = "Options", class: className = "" } = Astro.props;
---

<div class:list={["tab-card", className]} data-tab-card>
  <TabList ariaLabel={ariaLabel}>
    {
      tabs.map((t, i) => (
        <TabItem label={t.label} value={t.value} selected={i === 0} />
      ))
    }
  </TabList>
  <div class="tab-card-panels">
    {
      tabs.map((t, i) => (
        <div
          class:list={["tab-card-panel", { "is-active": i === 0 }]}
          data-tab-panel={t.value}
          role="tabpanel"
        >
          <slot name={t.value} />
        </div>
      ))
    }
  </div>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-tab-card]")
    .forEach((card) => {
      const panels = Array.from(
        card.querySelectorAll<HTMLElement>("[data-tab-panel]"),
      );
      card.addEventListener("tab-change", (e) => {
        const value = (e as CustomEvent).detail.value as string;
        panels.forEach((p) =>
          p.classList.toggle("is-active", p.dataset.tabPanel === value),
        );
      });
    });
</script>

<style>
  .tab-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-neutral-0);
    border: 1px solid var(--color-border-faint);
    border-radius: 12px;
    overflow: hidden;
  }

  /* Tab bar: flat row, separator line below */
  .tab-card :global(.tab-list) {
    width: 100%;
    padding: 0;
    border-radius: 0;
    background-color: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border-default);
  }

  /* Hide the sliding pill indicator — selected tab uses its own background */
  .tab-card :global(.tab-indicator) {
    display: none;
  }

  /* Browser-tab style: unselected has subtle gray fill, selected is white with blue underline */
  .tab-card :global(.tab-item) {
    height: 48px;
    padding: 0 20px;
    border-radius: 0;
    background-color: var(--color-neutral-100);
    color: var(--color-text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .tab-card :global(.tab-item[aria-selected="true"]) {
    background-color: var(--color-neutral-0);
    color: var(--color-text-heading);
    border-bottom-color: var(--color-accent-warning);
  }

  .tab-card-panels {
    padding: 0;
  }

  .tab-card-panel {
    display: none;
  }

  .tab-card-panel.is-active {
    display: block;
  }

  /* Image/visual edge-to-edge; text gets horizontal + bottom padding */
  .tab-card-panel :global(p),
  .tab-card-panel :global(.body-copy) {
    padding: var(--spacing-padding-sm) var(--spacing-padding-md) var(--spacing-padding-md);
    margin: 0;
  }
</style>
