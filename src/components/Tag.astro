---
interface Props {
  label: string;
  dot?: "success";
  size?: "md" | "sm";
  variant?: "default" | "inverse";
  class?: string;
}

const {
  label,
  dot,
  size = "md",
  variant = "default",
  class: className = "",
} = Astro.props;
---

<span class:list={["tag", `is-${size}`, `is-${variant}`, className]}>
  {dot === "success" && <span class="tag-dot" aria-hidden="true" />}
  <span class="type-tag tag-label">{label}</span>
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-gap-sm);
    border: none;
    background-color: var(--color-neutral-200);
    border-radius: 999px;
    color: var(--color-text-body-secondary);
    white-space: nowrap;
    box-sizing: border-box;
  }

  .tag.is-inverse {
    background-color: var(--color-bg-inverse);
    color: var(--color-text-on-inverse);
  }

  .tag.is-md {
    height: 32px;
    padding: 0 var(--spacing-padding-md);
  }

  .tag.is-sm {
    height: 24px;
    padding: 0 var(--spacing-padding-sm);
    gap: var(--spacing-gap-xs);
  }

  .tag.is-sm .tag-label {
    font-size: 0.75rem;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: var(--color-text-heading);
    flex-shrink: 0;
  }

  .tag.is-sm .tag-dot {
    width: 5px;
    height: 5px;
  }

  .tag-label {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0;
    text-transform: none;
    line-height: 1;
  }
</style>
