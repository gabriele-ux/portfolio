---
interface Props {
  label: string;
  dot?: "success";
  size?: "md" | "sm";
  class?: string;
}

const { label, dot, size = "md", class: className = "" } = Astro.props;
---

<span class:list={["tag", `is-${size}`, className]}>
  {dot === "success" && <span class="tag-dot" aria-hidden="true" />}
  <span class="type-tag tag-label">{label}</span>
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-gap-sm);
    border: 1px solid var(--color-chip-border);
    background-color: var(--color-chip-bg);
    border-radius: 8px;
    color: var(--color-text-body);
    white-space: nowrap;
    box-sizing: border-box;
  }

  .tag.is-md {
    height: 36px;
    padding: 0 var(--spacing-padding-md);
  }

  .tag.is-sm {
    height: 26px;
    padding: 0 var(--spacing-padding-sm);
    gap: var(--spacing-gap-xs);
    border-radius: 6px;
  }

  .tag.is-sm .tag-label {
    font-size: 0.75rem;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: var(--color-chip-dot-success);
    flex-shrink: 0;
  }

  .tag.is-sm .tag-dot {
    width: 5px;
    height: 5px;
  }

  .tag-label {
    line-height: 1;
  }
</style>
