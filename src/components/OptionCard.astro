---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = "" } = Astro.props;
---

<article class:list={["option-card", className]}>
  <h3 class="option-card-title">{title}</h3>
  <ul class="option-card-rows">
    <slot />
  </ul>
</article>

<style>
  .option-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-md);
    padding: var(--spacing-padding-md);
    background-color: var(--color-bg-overlay-medium);
    border: 1px solid var(--color-border-default);
    border-radius: 4px;
    overflow: clip;
  }

  .option-card-title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: var(--font-weight-medium);
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-heading);
  }

  .option-card-rows {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
