---
// Non-interactive schema for the "RAG database" exploration of pivot 3.
// Shows the classic RAG pipeline: change data → embeddings → vector DB →
// LLM → answer. Kept intentionally simple, in line with Pivot2BeforeSchema.
---

<div class="p3rs" aria-label="RAG pipeline: change data, embeddings, vector database, LLM, answer">
  <div class="p3rs-lane">
    <div class="p3rs-node">
      <span class="p3rs-node-label">Change data</span>
      <span class="p3rs-node-hint">Changelog entries</span>
    </div>

    <svg class="p3rs-arrow" width="28" height="10" viewBox="0 0 28 10" fill="none" aria-hidden="true">
      <path d="M0 5H26M22 1L26 5L22 9" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <div class="p3rs-node">
      <span class="p3rs-node-label">Embeddings</span>
      <span class="p3rs-node-hint">Vector encoding</span>
    </div>

    <svg class="p3rs-arrow" width="28" height="10" viewBox="0 0 28 10" fill="none" aria-hidden="true">
      <path d="M0 5H26M22 1L26 5L22 9" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <div class="p3rs-node p3rs-node-store">
      <span class="p3rs-node-label">Vector DB</span>
      <span class="p3rs-node-hint">Semantic index</span>
    </div>

    <svg class="p3rs-arrow" width="28" height="10" viewBox="0 0 28 10" fill="none" aria-hidden="true">
      <path d="M0 5H26M22 1L26 5L22 9" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <div class="p3rs-node">
      <span class="p3rs-node-label">LLM</span>
      <span class="p3rs-node-hint">Retrieval + reasoning</span>
    </div>

    <svg class="p3rs-arrow" width="28" height="10" viewBox="0 0 28 10" fill="none" aria-hidden="true">
      <path d="M0 5H26M22 1L26 5L22 9" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <div class="p3rs-node p3rs-node-answer">
      <span class="p3rs-node-label">Answer</span>
      <span class="p3rs-node-hint">Search result</span>
    </div>
  </div>
</div>

<style>
  .p3rs {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 3.2%, 32px);
    background: #f3f5f6;
    box-sizing: border-box;
  }

  .p3rs-lane {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    max-width: 720px;
    flex-wrap: nowrap;
    min-width: 0;
  }

  .p3rs-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-heading);
    font-family: var(--font-sans);
    text-align: center;
    flex: 1 1 0;
    min-width: 0;
  }

  .p3rs-node-label {
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
  }

  .p3rs-node-hint {
    font-size: 10px;
    font-weight: var(--font-weight-light);
    line-height: 1.25;
    color: var(--color-text-muted);
  }

  .p3rs-node-store {
    border-color: var(--color-border-highlight-info);
    background: var(--color-bg-info-subtle);
    color: var(--color-text-highlight-info);
  }

  .p3rs-node-store .p3rs-node-hint {
    color: var(--color-text-highlight-info);
    opacity: 0.75;
  }

  .p3rs-node-answer {
    border-color: var(--color-neutral-800);
    background: var(--color-neutral-800);
    color: var(--color-text-on-inverse);
  }

  .p3rs-node-answer .p3rs-node-hint {
    color: var(--color-text-on-inverse);
    opacity: 0.7;
  }

  .p3rs-arrow {
    color: var(--color-border-emphasized);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .p3rs-node-label {
      font-size: 10px;
    }
    .p3rs-node-hint {
      font-size: 9px;
    }
    .p3rs-lane {
      gap: 4px;
    }
    .p3rs-arrow {
      width: 16px;
    }
  }
</style>
