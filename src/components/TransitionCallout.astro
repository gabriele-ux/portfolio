---
interface Props {
  title: string;
  variant?: "warning" | "info" | "neutral";
  class?: string;
}

const {
  title,
  variant = "neutral",
  class: className = "",
} = Astro.props;
---

<div class:list={["transition-callout", `is-${variant}`, className]}>
  <span class="connector-line" aria-hidden="true"></span>
  <span class="connector-dot" aria-hidden="true"></span>
  <svg
    class="connector-arrow"
    width="14"
    height="14"
    viewBox="0 0 14 14"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M7 0 L7 14 M1 8 L7 14 L13 8"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>

  <div class="callout-box">
    <p class="type-body callout-title">{title}</p>
  </div>
</div>

<style>
  .transition-callout {
    position: relative;
    padding: 32px 0;
    display: flex;
    justify-content: center;
    isolation: isolate;
  }

  .transition-callout.is-warning {
    --connector-color: var(--color-border-highlight-warning);
  }
  .transition-callout.is-info {
    --connector-color: var(--color-border-highlight-info);
  }
  .transition-callout.is-neutral {
    --connector-color: var(--color-border-emphasized);
  }

  .connector-line {
    position: absolute;
    top: 6px;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    background-color: var(--connector-color);
    z-index: 0;
  }

  .connector-dot {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background-color: var(--connector-color);
    z-index: 2;
  }

  .connector-arrow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    color: var(--connector-color);
    z-index: 2;
  }

  .callout-box {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-padding-sm) var(--spacing-padding-md);
    border: 1px solid var(--connector-color);
    border-radius: 8px;
    background-color: var(--color-bg-elevated);
    text-align: center;
  }

  .callout-title {
    color: var(--color-text-heading);
    margin: 0;
  }
</style>
